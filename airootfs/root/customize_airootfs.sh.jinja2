#!/bin/bash
# Image customization, run by mkarchiso inside the image chroot (build time only).
# Original: ToriLinux (sasha0552, MIT). Reworked by Victorious / Victorious Framework.
set -euo pipefail

export CUSTOMIZE_AIROOTFS=/root/customize_airootfs
export HOME=/home/victor
export PATH=$HOME/.local/bin:$PATH

# The 'victor' account has NO password (locked in /etc/shadow). The physical console auto-logs in;
# network logins are impossible until the owner adds an SSH key (see victor-priv / Control Center).
# Nothing here may set a shared password.
passwd -l victor >/dev/null
passwd -l root >/dev/null

# Phone mirroring: android-udev provides adbusers + udev rules when installed.
# Skip quietly on profiles that do not include it, so the build cannot fail.
if getent group adbusers >/dev/null; then
  usermod -aG adbusers victor
fi

find /root -type f -name "*.jinja2" -print -delete

{% if rustdeskv %}
# RustDeskV (built in; leave out with --no-rustdeskv / VICTOR_RUSTDESKV=0). Installed OFFLINE from the file that
# scripts/prepare-sources.sh fetched and checked against the SHA-256 pinned in .ci/options.ini. Libraries come from the
# package list. --noscriptlet: the package's own post-install would start its stock service in the chroot; the image uses
# victor-rustdeskv.service instead, which does not run until the owner has chosen a password.
[ -f /root/sources/rustdeskv/rustdeskv.pkg.tar.zst ] || { echo "RustDeskV package missing: run scripts/prepare-sources.sh (or build with --no-rustdeskv)" >&2; exit 1; }
# pacman's CheckSpace cannot find a root mount point inside mkarchiso's airootfs chroot ("could not determine root mount point /"),
# so it reports "not enough free disk space" for any package. Use a throwaway copy of pacman.conf without CheckSpace for this one
# install only; the image's own /etc/pacman.conf is not touched.
rd_conf=$(mktemp)
sed '/^[[:space:]]*CheckSpace/d' /etc/pacman.conf > "$rd_conf"
pacman --config "$rd_conf" -U --noconfirm --noscriptlet --nodeps --nodeps /root/sources/rustdeskv/rustdeskv.pkg.tar.zst
rm -f "$rd_conf"
[ -x /usr/bin/rustdesk ] || { echo "RustDeskV install failed: /usr/bin/rustdesk missing" >&2; exit 1; }
systemctl disable rustdesk.service 2>/dev/null || true
systemctl enable victor-rustdeskv-restore.service victor-rustdeskv.service
{% if type == "gui" %}
install -m 644 /usr/share/rustdesk/files/rustdesk.desktop /usr/share/rustdesk/files/rustdesk-link.desktop /usr/share/applications/
{% endif %}
# the ID and keys are made per device at first run; none may exist in the image
rm -rf /root/.config/rustdesk
{% endif %}
{% if not rustdeskv or type != "gui" %}
rm -f /usr/share/applications/victor-rustdeskv.desktop /usr/share/applications/victor-rustdeskv-setup.desktop
{% endif %}
{% if not rustdeskv %}
rm -f /usr/local/bin/victor-rustdeskv /usr/local/lib/victorlinux/victor-rustdeskv-priv /usr/local/lib/victorlinux/victorrustdeskv.py \
      /etc/systemd/system/victor-rustdeskv.service /etc/systemd/system/victor-rustdeskv-restore.service
sed -i '/victor-rustdeskv-priv/d' /etc/sudoers.d/10-victor
{% endif %}


# user and runtime dirs with correct ownership
install -d -o victor -g victor -m 700 /home/victor /home/victor/.cache/victorlinux
chown -R victor:victor /home/victor

systemctl disable sshd.service 2>/dev/null || true
systemctl mask sshd.socket 2>/dev/null || true
# Bluetooth and the Wi-Fi input receiver stay off until the owner turns them on.
# Installing bluez must not change that default, so do not enable either unit.
systemctl disable bluetooth.service 2>/dev/null || true
systemctl disable victor-input.service 2>/dev/null || true
# Victorious Mesh is off by default: tailscaled only runs after the owner joins (victor-mesh / Control Center).
systemctl disable tailscaled.service 2>/dev/null || true
systemctl enable victor-boot-setup.service
systemctl enable systemd-networkd.service

{% if platform == "cuda" %}
# pre-fetched and checksummed by scripts/prepare-sources.sh (no network inside the chroot)
install -m 755 /root/sources/nvidia-pstated /usr/local/bin/nvidia-pstated
systemctl enable nvidia-persistenced
systemctl enable nvidia-pstated.service
{% endif %}

{% if type != "empty" %}
# llama.cpp backends (root, build time)
for script in "$CUSTOMIZE_AIROOTFS"/root-scripts/*.sh; do
  echo "===> Executing root script $script"
  # root's build must not write into the unprivileged user's home (ccache, caches)
  HOME=/root CCACHE_DISABLE=1 bash "$script"
done
rm -rf /root/sources
chown -R victor:victor /home/victor

# optional packs (as the unprivileged user)
{% if platform == "cuda" and packs %}
su victor -c "pipx install transient-package"
{% endif %}
cd /home/victor
for script in "$CUSTOMIZE_AIROOTFS"/scripts/*.sh; do
  echo "===> Executing script $script"
  chmod +x "$script"
  su victor -c "$script"
  {% if "hip" in packs or platform == "amd" %}
  rdfind -checksum sha256 -makehardlinks true -makeresultsfile false "." >/dev/null
  {% endif %}
done
{% endif %}

# release stamp shown in diagnostics
rm -f /etc/os-release
cat > /etc/os-release <<'OS'
NAME="VictorLinux"
PRETTY_NAME="VictorLinux (Arch edition)"
ID=victorlinux
ID_LIKE=arch
HOME_URL="https://github.com/Victorious93/VictorLinux"
OS
cat > /etc/victor-release <<REL
VictorLinux (Victorious fork)
platform={{ platform }} type={{ type }} packs={{ packs|join(",") or "none" }}
arch_snapshot={{ build.arch_snapshot }}
$(cat /opt/llama.cpp/BUILDINFO 2>/dev/null || echo "llama.cpp: not included")
$(pacman -Q rustdesk 2>/dev/null | sed 's/^rustdesk /rustdeskv: rustdesk /' || true)
REL

rm -fr "$CUSTOMIZE_AIROOTFS"
