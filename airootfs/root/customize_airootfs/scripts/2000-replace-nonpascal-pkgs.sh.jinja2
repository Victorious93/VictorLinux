#!/bin/sh
set -eu
{% if platform == "cuda" and ("comfyui" in packs or "automatic" in packs or "vllm" in packs or "invokeai" in packs) %}
export PIP_EXTRA_INDEX_URL="https://sasha0552.github.io/pascal-pkgs-ci/"
replace_package() {
  package=$1
  find /home/victor -type d -wholename "*/site-packages/$package-*.dist-info" | while IFS= read -r dir; do
    interpreter=$(realpath -s "$dir/../../../../bin/python")
    transient-package install --interpreter "$interpreter" --source "$package" --target "$package-pascal"
  done
}
replace_package triton
{% endif %}
