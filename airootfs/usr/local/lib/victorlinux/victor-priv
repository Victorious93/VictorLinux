#!/usr/bin/env python3
"""Restricted privileged helper for VictorLinux (run via `sudo -n`, as root).

This is the ONLY thing the unprivileged 'victor' user may run as root (see
/etc/sudoers.d/10-victor). Every sub-command validates its arguments strictly;
nothing here evaluates shell strings or accepts arbitrary paths/commands.
"""
import ipaddress
import json
import os
import pwd
import re
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import victorstorage as vs  # noqa: E402
import diskhealth  # noqa: E402
import victorssh  # noqa: E402
import hotspot  # noqa: E402

RUN = "/run/victor"
STATE = f"{RUN}/persist.json"
DATA_MNT = "/mnt/victordata"
RO_BASE = "/mnt/victor-ro"           # legacy read-only model mounts (kept for existing settings)
VOL_BASE = vs.VOL_BASE
TEMP = "/run/victor-temp-data"
USER = "victor"
SUBDIRS = ("models", "chats", "config", "images", "outputs", "documents", "logs", "server", "security")
UUID_RE = re.compile(r"^[0-9A-Za-z][0-9A-Za-z\-]{3,63}$")        # ext4 UUIDs, FAT/exFAT serials, NTFS serials
PERSIST_FS = ("ext4", "ext3", "ext2", "btrfs", "xfs", "f2fs")        # need POSIX ownership/permissions
RO_FS = PERSIST_FS + ("exfat", "ntfs", "vfat")
# block-device types that may carry a filesystem ("disk" = filesystem directly on the whole device, no partition table)
FS_TYPES = ("part", "disk", "loop", "crypt", "lvm")
SSHD_DROPIN = "/etc/ssh/sshd_config.d/10-victor.conf"
KEYS = f"/home/{USER}/.ssh/authorized_keys"
KEY_TYPES = victorssh.KEY_TYPES


def die(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def run(cmd, **kw):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, **kw)
    except FileNotFoundError:
        return subprocess.CompletedProcess(cmd, 127, "", f"{cmd[0]}: command not found")


def write_state(d):
    os.makedirs(RUN, exist_ok=True)
    os.chmod(RUN, 0o755)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(d, f)
    os.chmod(tmp, 0o644)
    os.replace(tmp, STATE)


def boot_devices():
    """Devices backing the live medium - never offered as storage or touched."""
    devs = set()
    for mp in ("/run/archiso/bootmnt", "/run/archiso/copytoram"):
        r = run(["findmnt", "-n", "-o", "SOURCE", "--target", mp])
        if r.returncode == 0 and r.stdout.strip().startswith("/dev/"):
            devs.add(os.path.realpath(r.stdout.strip()))
    return devs


def lsblk():
    try:
        return vs.lsblk_tree()
    except vs.StorageError as e:
        die(str(e))


flatten = vs.flatten


def part_by_uuid(uuid):
    if not UUID_RE.match(uuid or ""):
        die("Invalid UUID format.")
    hits = [d for d in flatten(lsblk()) if d.get("uuid") and d["uuid"].lower() == uuid.lower() and d["type"] in FS_TYPES and d.get("fstype")
            and not (d["type"] == "disk" and d.get("children"))]
    if len(hits) > 1:
        die(f"Refusing: {len(hits)} drives share filesystem UUID {uuid} ({', '.join(h['path'] for h in hits)}). "
            "Disconnect one of them, or give one a new UUID, then try again.")
    if not hits:
        die("No filesystem with that UUID was found.")
    return hits[0]


def is_boot_dev(d):
    bd = boot_devices()
    p = d
    while p:
        if os.path.realpath(p["path"]) in bd:
            return True
        p = p.get("_parent")
    return False


def mounted_at(path):
    return run(["mountpoint", "-q", path]).returncode == 0


def ensure_tree(root):
    pw = pwd.getpwnam(USER)
    for s in SUBDIRS:
        p = os.path.join(root, s)
        os.makedirs(p, exist_ok=True)
        os.chown(p, pw.pw_uid, pw.pw_gid)
    os.chmod(os.path.join(root, "config"), 0o700)
    os.chmod(root, 0o755)
    os.chown(root, pw.pw_uid, pw.pw_gid)


def link_home(root):
    link = f"/home/{USER}/victor-data"
    try:
        if os.path.islink(link) or os.path.exists(link):
            os.unlink(link)
        os.symlink(root, link)
        pw = pwd.getpwnam(USER)
        os.lchown(link, pw.pw_uid, pw.pw_gid)
    except OSError:
        pass


def volumes():
    """Every filesystem on this PC (internal, external, USB, SD), minus the live boot medium's own partition."""
    vols = vs.volumes_from_tree(lsblk(), vs.mount_table(), boot_devices())
    return [v for v in vols if not v["boot_medium"]]


def cmd_list_storage(_a):
    out = []
    for v in volumes():
        v = dict(v)
        v["persist_ok"] = v["fstype"] in PERSIST_FS and not v["locked"]     # may hold application state
        v["ro_ok"] = v["supported"] and not v["locked"]                    # may be read; most are writable too
        out.append(v)
    print(json.dumps({"partitions": out, "state": json.load(open(STATE)) if os.path.exists(STATE) else None}))


def vol_dir(uuid):
    return os.path.join(VOL_BASE, re.sub(r"[^0-9A-Za-z\-]", "", uuid))


def mount_options(fstype, ro):
    pw = pwd.getpwnam(USER)
    o = ["nosuid", "nodev", "noexec"]
    if fstype in ("vfat", "exfat", "ntfs"):
        # no Unix permissions on these: present everything as owned by the desktop user, files never executable
        o += [f"uid={pw.pw_uid}", f"gid={pw.pw_gid}", "dmask=0022", "fmask=0133"]
    if fstype == "vfat":
        o += ["shortname=mixed", "iocharset=utf8", "flush"]
    if fstype == "ntfs":
        o += ["windows_names"]
    elif fstype in PERSIST_FS:
        o += ["noatime"]
    o.append("ro" if ro else "rw")
    return ",".join(o)


def mount_volume(d, want_ro=False):
    """Mount a volume (once). Returns dict(mountpoint, rw, message). Never forces: a dirty/hibernated NTFS volume or an
    ext4 volume that needs repair is mounted read-only and reported, never written to and never repaired here."""
    if is_boot_dev(d):
        die("Refusing: that is the live boot medium's own partition.")
    if d["fstype"] in vs.LOCKED_TYPES:
        die("That volume is encrypted and locked. Unlock it first; VictorLinux cannot unlock it for you yet.")
    if d["fstype"] not in vs.FILESYSTEMS:
        die(f"Unsupported filesystem '{d['fstype']}'.")
    # already mounted somewhere (state volume, desktop automount, earlier call)? reuse it
    for v in vs.volumes_from_tree(lsblk(), vs.mount_table(), boot_devices()):
        if v["path"] == d["path"] and v["mounted"]:
            mp = v["mountpoint"]
            return {"mountpoint": mp, "rw": not v["mounted_ro"], "message": "already mounted" + (" read-only" if v["mounted_ro"] else "")}
    mp = vol_dir(d["uuid"])
    os.makedirs(mp, exist_ok=True)
    fs = "ntfs3" if d["fstype"] == "ntfs" else d["fstype"]
    note = ""
    if not want_ro:
        r = run(["mount", "-t", fs, "-o", mount_options(d["fstype"], False), d["path"], mp])
        if r.returncode == 0:
            return {"mountpoint": mp, "rw": True, "message": "mounted read-write"}
        note = ("Could not mount read-write (" + (r.stderr.strip().splitlines() or ["unknown error"])[-1] + "); "
                "mounted read-only instead. Nothing was repaired or forced. For an NTFS drive: fully shut Windows down "
                "(disable Fast Startup / hibernation) and run its disk check, then reconnect.")
    r = run(["mount", "-t", fs, "-o", mount_options(d["fstype"], True), d["path"], mp])
    if r.returncode != 0:
        try:
            os.rmdir(mp)
        except OSError:
            pass
        die("Mount failed: " + (r.stderr.strip() or "unknown error"))
    return {"mountpoint": mp, "rw": False, "message": note or "mounted read-only as requested"}


def cmd_volume_mount(a):
    if len(a) not in (1, 2) or (len(a) == 2 and a[1] not in ("ro", "rw")):
        die("usage: volume-mount UUID [ro|rw]")
    print(json.dumps(mount_volume(part_by_uuid(a[0]), len(a) == 2 and a[1] == "ro")))


def cmd_volume_umount(a):
    if len(a) != 1:
        die("usage: volume-umount UUID")
    mp = vol_dir(a[0] if UUID_RE.match(a[0] or "") else die("Invalid UUID format."))
    if os.path.commonpath([mp, VOL_BASE]) != VOL_BASE or not mounted_at(mp):
        die("That volume is not mounted by VictorLinux.")
    r = run(["umount", mp])
    if r.returncode != 0:
        die("Could not unmount (files may be open): " + r.stderr.strip())
    try:
        os.rmdir(mp)
    except OSError:
        pass
    print("unmounted; safe to disconnect after the drive's activity light stops")


def writable_by(path, uid, gid):
    st = os.stat(path)
    m = st.st_mode
    if st.st_uid == uid:
        return bool(m & 0o200)
    if st.st_gid == gid:
        return bool(m & 0o020)
    return bool(m & 0o002)


def cmd_dest_prepare(a):
    """Create the requested application folder (and only it) on a mounted, writable volume."""
    if len(a) != 2:
        die("usage: dest-prepare UUID SUBPATH")
    d = part_by_uuid(a[0])
    m = mount_volume(d)
    if not m["rw"]:
        die("That drive is mounted read-only: " + m["message"])
    try:
        sub = vs.validate_subpath(a[1])
        root = os.path.realpath(m["mountpoint"])
        pw = pwd.getpwnam(USER)
        cur = root
        for part in [x for x in sub.split("/") if x]:
            nxt = os.path.join(cur, part)
            if os.path.islink(nxt):
                die("Refusing: a component of that folder is a symbolic link.")
            if not os.path.isdir(nxt):
                os.mkdir(nxt, 0o755)
                if d["fstype"] in PERSIST_FS:
                    os.chown(nxt, pw.pw_uid, pw.pw_gid)      # only the folder we just created; never recursive
            cur = nxt
        final = vs.contained_path(root, sub)
        if d["fstype"] in PERSIST_FS and not writable_by(final, pw.pw_uid, pw.pw_gid):
            die(f"The folder '{sub or '/'}' already exists but is owned by someone else and the desktop user cannot write to it. "
                "VictorLinux never changes ownership of existing files. Pick a new folder name (it will be created for you).")
    except (vs.StorageError, OSError) as e:
        die(f"Cannot prepare that folder: {e}")
    print(json.dumps({"path": final, "mountpoint": m["mountpoint"], "rw": True}))


def cmd_dest_apply(_a):
    """Mount every drive named by the saved destination preferences (read from the active state volume)."""
    st = json.load(open(STATE)) if os.path.exists(STATE) else {}
    root = st.get("data_root")
    if st.get("mode") not in ("persistent", "temporary") or not root:
        print(json.dumps({"applied": [], "message": "no storage state yet"}))
        return
    cfg = vs.load_config(os.path.join(root, "config", "storage.json"))
    vols = volumes()
    done = []
    for role, rows in cfg["destinations"].items():
        for e in rows if isinstance(rows, list) else []:
            ref = e.get("ref", {}) if isinstance(e, dict) else {}
            if not UUID_RE.match(str(ref.get("uuid", ""))):
                continue
            v, status, msg = vs.resolve_volume(vols, ref)
            if not v:
                done.append({"role": role, "status": status, "message": msg})
                continue
            try:
                m = mount_volume(next(d for d in flatten(lsblk()) if d["path"] == v["path"]))
                done.append({"role": role, "status": "mounted", "mountpoint": m["mountpoint"], "rw": m["rw"], "message": m["message"]})
            except SystemExit:
                done.append({"role": role, "status": "error", "message": "mount refused"})
    print(json.dumps({"applied": done}))


def cmd_persist_mount(a):
    if len(a) != 1:
        die("usage: persist-mount UUID")
    d = part_by_uuid(a[0])
    if is_boot_dev(d):
        die("Refusing: that is the live boot medium's own boot partition.")
    if d["fstype"] not in PERSIST_FS:
        die(f"Filesystem '{d['fstype']}' cannot hold Linux permissions. Use ext4 (label TORIDATA) for persistent storage.")
    if mounted_at(DATA_MNT):
        run(["umount", DATA_MNT])
    os.makedirs(DATA_MNT, exist_ok=True)
    r = run(["mount", "-o", "rw,nosuid,nodev,noexec,noatime", d["path"], DATA_MNT])
    if r.returncode != 0:
        write_state({"mode": "error", "uuid": a[0], "data_root": None, "message": "Mount failed: " + r.stderr.strip()})
        die("Mount failed: " + r.stderr.strip())
    try:
        root = persistence_root(DATA_MNT)
        os.makedirs(root, exist_ok=True)
        probe = os.path.join(root, ".write-test")
        with open(probe, "w") as f:
            f.write("ok")
        os.unlink(probe)
        ensure_tree(root)
    except (OSError, ValueError) as e:
        run(["umount", DATA_MNT])
        write_state({"mode": "readonly", "uuid": a[0], "data_root": None,
                     "message": f"Storage is mounted but not writable ({e}). It may be read-only, full or damaged. "
                                "Fix it from another system, or start an explicit temporary session."})
        die(f"Storage not writable: {e}")
    link_home(root)
    write_state({"mode": "persistent", "uuid": a[0], "device": d["path"], "label": d.get("label"),
                 "fstype": d["fstype"], "data_root": root, "mount": DATA_MNT, "message": f"Persistent storage active on {d['path']} ({d.get('label') or a[0]})."})
    restored = restore_ssh_keys()
    print("persistent storage mounted at " + root + (f" ({restored} SSH key(s) restored)" if restored else ""))


def persistence_root(mount):
    current, legacy = os.path.join(mount, "victorlinux"), os.path.join(mount, "tori")
    if os.path.isdir(current) and os.path.isdir(legacy):
        raise ValueError("Both victorlinux and legacy tori data directories exist; resolve the duplicate before selecting this drive.")
    return legacy if os.path.isdir(legacy) else current


PROBE_OPTS = {"ext4": "noload", "ext3": "noload", "ext2": "", "xfs": "norecovery", "btrfs": "", "f2fs": ""}


def has_victor_tree(d):
    """Peek (read-only, no journal replay) for an existing VictorLinux data folder on a Linux filesystem."""
    mp = os.path.join(RUN, "probe")
    os.makedirs(mp, exist_ok=True)
    opts = ",".join(x for x in ("ro", "nosuid", "nodev", "noexec", PROBE_OPTS.get(d["fstype"], "")) if x)
    if run(["mount", "-o", opts, d["path"], mp]).returncode != 0:
        return False
    try:
        return os.path.isdir(os.path.join(mp, "victorlinux")) or os.path.isdir(os.path.join(mp, "tori"))
    finally:
        run(["umount", mp])


def cmd_persist_auto(_a):
    vols = flatten(lsblk())
    cands = [d for d in vols if d.get("label") in ("VICTORDATA", "TORIDATA") and d.get("fstype") in PERSIST_FS and not is_boot_dev(d)]
    if not cands:
        # No labelled drive: accept exactly one Linux-filesystem volume that already holds a VictorLinux data folder.
        cands = [d for d in flatten(lsblk()) if d["type"] in FS_TYPES and d.get("fstype") in PERSIST_FS and d.get("uuid")
                 and not is_boot_dev(d) and not (d["type"] == "disk" and d.get("children")) and has_victor_tree(d)]
    if not cands:
        write_state({"mode": "missing", "data_root": None,
                     "message": "No persistent storage found (expected VICTORDATA, legacy TORIDATA, or one Linux volume that already has a "
                                "victorlinux/ folder). Nothing will be saved across reboots unless you pick storage or explicitly start a "
                                "temporary session."})
        print("missing")
        return
    if len(cands) > 1:
        write_state({"mode": "ambiguous", "data_root": None,
                     "message": "Several candidate data drives found; refusing to guess. Choose one explicitly."})
        print("ambiguous")
        return
    cmd_persist_mount([cands[0]["uuid"]])
    cmd_dest_apply([])


def cmd_persist_temp(_a):
    os.makedirs(TEMP, exist_ok=True)
    ensure_tree(TEMP)
    link_home(TEMP)
    write_state({"mode": "temporary", "data_root": TEMP,
                 "message": "TEMPORARY SESSION: everything saved (models, chats, settings) lives in RAM and is lost on reboot."})
    print("temporary session active")


def cmd_mount_ro(a):
    if len(a) != 1:
        die("usage: mount-ro UUID")
    print(mount_volume(part_by_uuid(a[0]), want_ro=True)["mountpoint"])


def cmd_ssh_status(_a):
    keys = 0
    if os.path.exists(KEYS):
        keys = victorssh.count_keys(KEYS)
    active = run(["systemctl", "is-active", "sshd"]).stdout.strip()
    listen = None
    if os.path.exists(SSHD_DROPIN):
        m = re.search(r"^ListenAddress (\S+)", open(SSHD_DROPIN).read(), re.M)
        listen = m.group(1) if m else None
    saved = persistent_keys_path()
    print(json.dumps({"active": active == "active", "authorized_keys": keys, "listen": listen,
                      "keys_persistent": bool(saved and os.path.exists(saved))}))


def persistent_keys_path():
    """Where the owner's authorized_keys is kept so it survives a reboot (only on real persistent storage)."""
    st = vs_state()
    if st.get("mode") == "persistent" and st.get("data_root"):
        return os.path.join(st["data_root"], "security", "ssh_authorized_keys")
    return None


def vs_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def owner_ids():
    pw = pwd.getpwnam(USER)
    return pw.pw_uid, pw.pw_gid


def save_ssh_keys():
    dst = persistent_keys_path()
    if dst and os.path.exists(KEYS):
        try:
            return victorssh.persist_keys(KEYS, dst)
        except OSError:
            return False
    return False


def restore_ssh_keys():
    """Called after persistent storage is mounted: put the saved authorized_keys back if the live one is gone."""
    src = persistent_keys_path()
    if not src:
        return 0
    try:
        return victorssh.restore_keys(src, KEYS, *owner_ids())
    except OSError:
        return 0


def cmd_ssh_add_key(_a):
    line = sys.stdin.read().strip()
    if "\n" in line or not line:
        die("Provide exactly one public key line.")
    try:
        line, fp = victorssh.validate_line(line)
    except victorssh.SSHKeyError as e:
        die(str(e))
    pw = pwd.getpwnam(USER)
    d = os.path.dirname(KEYS)
    os.makedirs(d, exist_ok=True)
    os.chown(d, pw.pw_uid, pw.pw_gid)
    os.chmod(d, 0o700)
    with open(KEYS, "a") as f:
        f.write(line + "\n")
    os.chown(KEYS, pw.pw_uid, pw.pw_gid)
    os.chmod(KEYS, 0o600)
    saved = save_ssh_keys()
    print("Key added: " + fp + ("" if saved else " (not saved: no persistent storage, so it is gone after a reboot)"))


def cmd_ssh_enable(a):
    if len(a) != 1:
        die("usage: ssh-enable LISTEN_ADDRESS")
    try:
        addr = str(ipaddress.ip_address(a[0]))
    except ValueError:
        die("Listen address must be an IP address.")
    if not os.path.exists(KEYS) or not open(KEYS).read().strip():
        die("Add an SSH public key first. Password logins are not supported.")
    save_ssh_keys()
    os.makedirs(os.path.dirname(SSHD_DROPIN), exist_ok=True)
    with open(SSHD_DROPIN, "w") as f:
        f.write(f"ListenAddress {addr}\nPasswordAuthentication no\nKbdInteractiveAuthentication no\n"
                f"PermitRootLogin no\nAllowUsers {USER}\nAuthenticationMethods publickey\nX11Forwarding no\n")
    run(["ssh-keygen", "-A"])
    r = run(["systemctl", "restart", "sshd"])
    if r.returncode != 0:
        die("sshd failed to start: " + r.stderr.strip())
    fp = run(["ssh-keygen", "-l", "-f", "/etc/ssh/ssh_host_ed25519_key.pub"]).stdout.strip()
    print(f"SSH enabled on {addr}:22 (key auth only). Host key: {fp}")


def cmd_ssh_disable(_a):
    run(["systemctl", "stop", "sshd"])
    print("SSH stopped. Authorized keys kept; use ssh-reset to remove them.")


def cmd_ssh_reset(_a):
    run(["systemctl", "stop", "sshd"])
    for p in (SSHD_DROPIN, KEYS, persistent_keys_path()):
        if not p:
            continue
        try:
            os.unlink(p)
        except FileNotFoundError:
            pass
    print("SSH stopped, all authorized keys and listen settings removed.")


def cmd_smart(a):
    """Read-only SMART health of one local disk (partition paths are mapped to their disk). Never writes."""
    if len(a) != 1:
        die("usage: smart /dev/DISK")
    try:
        print(json.dumps(diskhealth.collect_smart(a[0])))
    except ValueError as e:
        die(str(e))


def cmd_power(a):
    if a not in (["reboot"], ["poweroff"]):
        die("usage: power reboot|poweroff")
    os.execvp("systemctl", ["systemctl", a[0]])


INPUT_ENV = "/etc/default/victor-input"
INPUT_UNIT = "victor-input.service"


def _write_input_env(bind, port):
    os.makedirs(os.path.dirname(INPUT_ENV), exist_ok=True)
    with open(INPUT_ENV, "w") as f:
        f.write(f"VICTOR_INPUT_BIND={bind}\nVICTOR_INPUT_PORT={port}\n")
    os.chmod(INPUT_ENV, 0o644)


def _parse_input_args(a):
    bind = a[0] if a else "0.0.0.0"
    port = a[1] if len(a) > 1 else "8473"
    if not port.isdigit() or not 1024 <= int(port) <= 65535:
        die("port must be 1024-65535")
    try:
        ipaddress.ip_address(bind)
    except ValueError:
        if bind not in ("0.0.0.0", "::"):
            die("bind must be an IP address")
    return bind, port


def cmd_input_enable(a):
    bind, port = _parse_input_args(a)
    _write_input_env(bind, port)
    # Start now only. Never enable the unit on boot.
    r = run(["systemctl", "start", INPUT_UNIT])
    if r.returncode != 0:
        die("victor-input failed to start: " + (r.stderr or r.stdout).strip())
    print(json.dumps({"ok": True, "running": True, "bind": bind, "port": int(port), "enabled_on_boot": False,
                      "firewall_note": "Open TCP %s only while this service is on, and only for the address you chose." % port}))


def cmd_input_disable(_a):
    run(["systemctl", "stop", INPUT_UNIT])
    print(json.dumps({"ok": True, "running": False, "message": "Wi-Fi input is off. Paired devices stay listed until you revoke them."}))


def cmd_input_status(_a):
    active = run(["systemctl", "is-active", INPUT_UNIT]).stdout.strip()
    enabled = run(["systemctl", "is-enabled", INPUT_UNIT]).stdout.strip()
    print(json.dumps({"running": active == "active", "boot": enabled, "default_off": True}))


def _bt(args):
    exe = "/usr/local/bin/victor-bt-pair"
    r = run([exe, *args], timeout=30)
    if r.returncode != 0:
        die((r.stderr or r.stdout).strip() or "victor-bt-pair failed")
    print(r.stdout, end="" if r.stdout.endswith("\n") else "\n")


def cmd_bt_start(_a):
    # Starts bluetoothd for this session only; victor-bt-pair never enables it on boot.
    _bt(["start"])


def cmd_bt_confirm(_a):
    _bt(["confirm"])


def cmd_bt_cancel(_a):
    _bt(["cancel"])


def cmd_bt_status(_a):
    _bt(["status"])


def cmd_bt_list(_a):
    _bt(["list"])


def cmd_bt_unpair(a):
    if len(a) != 1:
        die("usage: bt-unpair MAC")
    _bt(["unpair", a[0]])


HOTSPOT_DIR = f"{RUN}/hotspot"
HOTSPOT_UNITS = ("victor-hotspot-ap", "victor-hotspot-dhcp")


def wifi_ifaces():
    r = run(["iw", "dev"])
    return hotspot.parse_iw_dev(r.stdout) if r.returncode == 0 else []


def cmd_hotspot_start(_a):
    """Isolated access point: hostapd + DHCP-only dnsmasq on one Wi-Fi interface. Settings (JSON) come on stdin and are
    re-validated here; no forwarding/NAT is set up, so joined devices reach only this PC."""
    try:
        c = hotspot.validate(json.loads(sys.stdin.read() or "{}"))
    except (ValueError, hotspot.HotspotError) as e:
        die(f"bad hotspot settings: {e}")
    ifaces = wifi_ifaces()
    iface = c["iface"] or (ifaces[0] if ifaces else "")
    if iface not in ifaces:
        die("No Wi-Fi interface found." if not ifaces else f"{iface} is not a Wi-Fi interface.")
    cmd_hotspot_stop([])
    os.makedirs(HOTSPOT_DIR, mode=0o700, exist_ok=True)
    for name, text in (("hostapd.conf", hotspot.hostapd_conf(iface, c)), ("dnsmasq.conf", hotspot.dnsmasq_conf(iface))):
        fd = os.open(f"{HOTSPOT_DIR}/{name}", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(text)
    run(["rfkill", "unblock", "wifi"])
    for cmd in (["ip", "link", "set", iface, "down"], ["ip", "addr", "flush", "dev", iface], ["ip", "link", "set", iface, "up"],
                ["ip", "addr", "add", f"{hotspot.ADDR}/{hotspot.PREFIX}", "dev", iface]):
        r = run(cmd)
        if r.returncode:
            die(f"{' '.join(cmd[:3])} failed: {r.stderr.strip()}")
    for unit, cmd in ((HOTSPOT_UNITS[0], ["hostapd", f"{HOTSPOT_DIR}/hostapd.conf"]),
                      (HOTSPOT_UNITS[1], ["dnsmasq", "-k", "-C", f"{HOTSPOT_DIR}/dnsmasq.conf"])):
        r = run(["systemd-run", f"--unit={unit}", "--collect", "--property=Restart=no", *cmd])
        if r.returncode:
            cmd_hotspot_stop([])
            die(f"{cmd[0]} could not start: {r.stderr.strip()}")
    print(json.dumps({"ok": True, "iface": iface, "address": hotspot.ADDR}))


def cmd_hotspot_stop(_a):
    for unit in HOTSPOT_UNITS:
        run(["systemctl", "stop", unit])
    try:
        with open(f"{HOTSPOT_DIR}/hostapd.conf") as f:
            m = re.search(r"^interface=(\S+)$", f.read(), re.M)
        if m and hotspot.IFACE_RE.fullmatch(m.group(1)):
            run(["ip", "addr", "del", f"{hotspot.ADDR}/{hotspot.PREFIX}", "dev", m.group(1)])
    except OSError:
        pass
    for name in ("hostapd.conf", "dnsmasq.conf"):
        try:
            os.unlink(f"{HOTSPOT_DIR}/{name}")
        except OSError:
            pass


