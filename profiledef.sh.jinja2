#!/usr/bin/env bash
# shellcheck disable=SC2034

iso_name="victorlinux"
iso_label="VICTOR_{{ platform|upper }}_{{ type|upper }}"
iso_publisher="VictorLinux (Victorious fork) <https://github.com/Victorious93/VictorLinux>"
iso_application="VictorLinux ({{ platform }}, {{ type }})"
iso_version="{{ platform }}-{{ type }}{% if packs %}-{{ packs|join("+") }}{% endif %}-$(date --date="@${SOURCE_DATE_EPOCH:-$(date +%s)}" "+%Y-%m-%d_%H-%M-%S")"
install_dir="victor"
buildmodes=("iso")
bootmodes=("bios.syslinux" "uefi.systemd-boot")
arch="x86_64"
pacman_conf="pacman.conf"
airootfs_image_type="squashfs"
airootfs_image_tool_options=("-comp" "zstd" "-Xcompression-level" "15" "-b" "1M")
{% if sccache %}
# VICTOR_SCCACHE=1 build: the compiler wrapper and its cache live in the airootfs work dir only so build-inner.sh can harvest
# the cache afterwards. They are EXCLUDED from the squashfs, so they can never ship in the ISO.
airootfs_image_tool_options+=("-e" "var/cache/victor-sccache" "usr/local/lib/victor-build")
{% endif %}
file_permissions=(
  ["/etc/gshadow"]="0:0:400"
  ["/etc/shadow"]="0:0:400"
  ["/etc/sudoers.d"]="0:0:750"
  ["/etc/sudoers.d/10-victor"]="0:0:440"
  ["/usr/local/lib/victorlinux/victor-priv"]="0:0:755"
  ["/usr/local/lib/victorlinux/control_center.py"]="0:0:644"
  ["/usr/local/lib/victorlinux/gateway.py"]="0:0:644"
  ["/usr/local/bin/victor-control-center"]="0:0:755"
  ["/usr/local/bin/victor-open"]="0:0:755"
  ["/usr/local/bin/victor-tls-cert"]="0:0:755"
  ["/usr/local/bin/victor-diag"]="0:0:755"
  ["/usr/local/bin/victor-model-import"]="0:0:755"
  ["/usr/local/bin/victor-storage"]="0:0:755"
  ["/usr/local/bin/victor-capcheck"]="0:0:755"
  ["/usr/local/bin/victor-bench"]="0:0:755"
  ["/usr/local/bin/victor-hardware"]="0:0:755"
  ["/usr/local/bin/victor-mic"]="0:0:755"
  ["/usr/local/lib/victorlinux/victor-boot-setup"]="0:0:755"
  ["/root/customize_airootfs.sh"]="0:0:755"
)
