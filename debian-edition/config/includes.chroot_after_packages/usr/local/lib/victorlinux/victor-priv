#!/usr/bin/env python3
"""victor-priv: the ONLY root-level helper for the Control Center. Fixed verbs, strict argument validation.

Callable by the owner via sudoers (no password) for exactly this file. It never executes caller-supplied
commands, mounts only partitions that are ext4 + label VICTORDATA or TORIDATA, and only reads owner-readable key files.
"""
import json, os, pwd, re, shutil, subprocess, sys
sys.path.insert(0, "/usr/local/lib/victorlinux")
from victorlib.common import *
from victorlib import storage, diskhealth
import victorssh

OWNER = "victor"
UUID_RE = re.compile(r"^[0-9a-fA-F-]{36}$")
NFT_TABLE = ("inet", "victor")


def die(msg, code=2):
    print(msg, file=sys.stderr); sys.exit(code)


def uid_gid():
    p = pwd.getpwnam(OWNER)
    return p.pw_uid, p.pw_gid


def set_state(state, message, **extra):
    uid, gid = uid_gid()
    os.makedirs(RUN, exist_ok=True)
    write_json_atomic(STATE_FILE, {"state": state, "message": message, **extra}, 0o644)


def link_root(target):
    if os.path.islink(ROOT_LINK) or os.path.exists(ROOT_LINK):
        os.unlink(ROOT_LINK)
    os.symlink(target, ROOT_LINK)
    # convenient, discoverable entry point for the owner's files (lives on the data partition)
    home = f"/home/{OWNER}/VictorData"
    try:
        if os.path.islink(home):
            os.unlink(home)
        if not os.path.exists(home):
            os.symlink(ROOT_LINK, home)
            os.lchown(home, *uid_gid())
    except OSError:
        pass


def selected_file():
    return f"{RUN}/selected.uuid"


def cmd_mount(uuid):
    if not UUID_RE.match(uuid):
        die("invalid UUID")
    cands = {c["uuid"]: c for c in storage.list_candidates()}
    if uuid not in cands:
        if not os.path.ismount(DATA_MP):      # never clobber the state of a healthy, already-mounted partition
            set_state("missing", f"Data partition {uuid} is not attached.")
        die(f"No ext4 partition labelled {" or ".join(DATA_LABELS)} with UUID {uuid} is attached.")
    c = cands[uuid]
    uid, gid = uid_gid()
    os.makedirs(RUN, exist_ok=True)
    os.chmod(RUN, 0o755)
    if os.path.ismount(DATA_MP):
        run(["umount", DATA_MP])
    os.makedirs(DATA_MP, exist_ok=True)
    # filesystem health BEFORE mounting rw
    fsstate = run(["dumpe2fs", "-h", c["path"]]).stdout
    clean = "Filesystem state:         clean" in fsstate
    opts = "nodev,nosuid,noexec,noatime" + ("" if clean else ",ro")
    r = run(["mount", "-t", "ext4", "-o", opts, f"UUID={uuid}", DATA_MP])
    if r.returncode != 0:
        r2 = run(["mount", "-t", "ext4", "-o", opts + ",ro", f"UUID={uuid}", DATA_MP])
        if r2.returncode != 0:
            set_state("damaged", "The data partition could not be mounted (filesystem damaged?). Run Storage > Check.",
                      uuid=uuid, detail=r.stderr.strip()[-300:])
            die("mount failed: " + r.stderr.strip())
    # noexec would break running binaries from the data disk; models/outputs never need exec.
    link_root(DATA_MP)
    if clean and storage.probe_active() and storage.probe_active()["writable"]:
        storage.ensure_layout(DATA_MP)
        run(["chown", "-R", f"{uid}:{gid}", DATA_MP + "/" + "models", DATA_MP + "/chat", DATA_MP + "/settings", DATA_MP + "/images",
             DATA_MP + "/llama", DATA_MP + "/kali", DATA_MP + "/documents", DATA_MP + "/logs", DATA_MP + "/secrets"])
        os.chown(DATA_MP, uid, gid)
    m = storage.probe_active()
    state, msg = storage.classify_mounted(DATA_MP, m["options"], m["free"], m["writable"])
    set_state(state, msg, uuid=uuid, device=c["path"], size=c["size"], model=c["model"], serial=c["serial"])
    open(selected_file(), "w").write(uuid)
    restore_ssh_keys()
    print(f"{state}: {msg}")


def cmd_auto():
    cands = storage.list_candidates()
    sel = open(selected_file()).read().strip() if os.path.exists(selected_file()) else None
    action, uuid, msg = storage.decide(cands, sel)
    if action == "mount":
        cmd_mount(uuid)
    else:
        set_state(action, msg, candidates=[{k: c[k] for k in ("uuid", "model", "serial", "size", "transport")} for c in cands])
        print(f"{action}: {msg}")


def cmd_session():
    uid, gid = uid_gid()
    os.makedirs(SESSION_MP, exist_ok=True)
    if not os.path.ismount(SESSION_MP):
        total = mem_info()["total"] or 0
        run(["mount", "-t", "tmpfs", "-o", f"size={max(total//4, 512*2**20)},mode=0700,uid={uid},gid={gid},nosuid,nodev", "tmpfs", SESSION_MP], check=True)
    storage.ensure_layout(SESSION_MP)
    run(["chown", "-R", f"{uid}:{gid}", SESSION_MP])
    link_root(SESSION_MP)
    set_state("session", "TEMPORARY SESSION: everything is kept in RAM and is lost at shutdown/reboot.")
    print("session")


def cmd_check():
    st = read_json(STATE_FILE, {})
    if not st.get("device"):
        die("no data partition is active")
    print(run(["dumpe2fs", "-h", st["device"]]).stdout)
    print("Read-only structural check requires the partition to be unmounted; run 'storage-repair' to fsck.")


def cmd_repair():
    st = read_json(STATE_FILE, {})
    dev = st.get("device")
    if not dev:
        die("no data partition is active")
    run(["umount", DATA_MP])
    r = run(["e2fsck", "-f", "-p", dev], timeout=3600)
    print(r.stdout, r.stderr)
    cmd_mount(st["uuid"])


def cmd_fw_sync(port, bind, enabled):
    if not port.isdigit() or not 1024 <= int(port) <= 65535 and port != "22":
        die("bad port")
    import ipaddress
    ip = ipaddress.ip_address(bind)
    if enabled == "1" and ip.is_loopback:
        die("refusing to open firewall for loopback")
    op = "add" if enabled == "1" else "delete"
    r = run(["nft", op, "element", *NFT_TABLE, "allowed_tcp", f"{{ {int(port)} }}"])
    if r.returncode and op == "add":
        die("nft failed: " + r.stderr.strip())


def cmd_hotspot_fw(iface, state):
    """Let devices on the hotspot get an address (DHCP/DNS) and keep them isolated (no forwarding)."""
    if not re.fullmatch(r"[a-zA-Z0-9_.-]{1,15}", iface) or not os.path.isdir(f"/sys/class/net/{iface}/wireless"):
        die("not a Wi-Fi interface")
    if state not in ("on", "off"):
        die("state must be on or off")
    r = run(["nft", "add" if state == "on" else "delete", "element", *NFT_TABLE, "hotspot_if", f"{{ {iface} }}"])
    if r.returncode and state == "on":
        die("nft failed: " + r.stderr.strip())


def owner_hash():
    for l in open("/etc/shadow"):
        f = l.split(":")
        if f[0] == OWNER:
            return f[1]
    return "!"


def require_current_password():
    """First-run (account still locked) needs nothing; any later change needs the CURRENT password on stdin line 1."""
    h = owner_hash()
    if h.startswith(("!", "*")) or h == "":
        return
    cur = sys.stdin.readline().rstrip("\n")
    parts = h.split("$")           # ['', '6', salt, hash]
    if len(parts) < 4 or parts[1] != "6":
        die("unsupported password hash")
    chk = run(["openssl", "passwd", "-6", "-salt", parts[2], "-stdin"], input=cur + "\n").stdout.strip()
    if chk != h:
        die("current password is wrong")


def cmd_password():
    require_current_password()
    pw = sys.stdin.readline().rstrip("\n")
    if len(pw) < 8:
        die("password must be at least 8 characters")
    h = run(["openssl", "passwd", "-6", "-stdin"], input=pw + "\n").stdout.strip()
    if not h.startswith("$6$"):
        die("hashing failed")
    run(["usermod", "-p", h, OWNER], check=True)
    if os.path.isdir(ROOT_LINK):
        p = os.path.join(root_dir(), "secrets", "owner.shadow")
        write_json_atomic(p, {"hash": h}, 0o600)
    # the owner may now use sudo with this password (full admin, deliberately password-gated)
    run(["usermod", "-aG", "sudo", OWNER])
    print("owner password set")


LIVE_KEYS = f"/home/{OWNER}/.ssh/authorized_keys"
SSHD_DROPIN = "/etc/ssh/sshd_config.d/10-victor.conf"


def saved_keys_path():
    """authorized_keys copy on VICTORDATA (same file the Pi edition uses). None in a temporary session."""
    if os.path.islink(ROOT_LINK) and os.path.realpath(ROOT_LINK) == os.path.realpath(DATA_MP) and os.path.ismount(DATA_MP):
        return os.path.join(DATA_MP, "secrets", "ssh_authorized_keys")
    return None


def restore_ssh_keys():
    src = saved_keys_path()
    if not src:
        return 0
    try:
        return victorssh.restore_keys(src, LIVE_KEYS, *uid_gid())
    except OSError:
        return 0


def cmd_ssh_enable(keyfile, bind):
    import ipaddress
    ip = ipaddress.ip_address(bind)
    if not os.path.isfile(keyfile) or os.path.getsize(keyfile) > 16384:
        die("key file must be a small regular file")
    st = os.stat(keyfile)
    if st.st_uid != uid_gid()[0]:
        die("key file must be owned by the owner account")
    try:
        lines = victorssh.valid_keys(open(keyfile).read())
    except victorssh.SSHKeyError as e:
        die("not a valid public key: " + str(e))
    if not lines:
        die("no public keys found; paste a line from ~/.ssh/id_ed25519.pub")
    uid, gid = uid_gid()
    d = os.path.dirname(LIVE_KEYS)
    os.makedirs(d, mode=0o700, exist_ok=True)
    os.chown(d, uid, gid); os.chmod(d, 0o700)
    victorssh.write_keys(LIVE_KEYS, lines, uid, gid)
    saved = saved_keys_path()
    if saved:
        victorssh.write_keys(saved, lines, uid, gid)
    os.makedirs("/etc/ssh/sshd_config.d", exist_ok=True)
    open(SSHD_DROPIN, "w").write(
        f"PasswordAuthentication no\nKbdInteractiveAuthentication no\nPermitRootLogin no\nAllowUsers {OWNER}\n"
        f"AuthenticationMethods publickey\nListenAddress {ip}\nAllowAgentForwarding no\nX11Forwarding no\n")
    run(["ssh-keygen", "-A"], check=True)
    run(["systemctl", "enable", "--now", "ssh"], check=True)
    run(["systemctl", "restart", "ssh"])
    if not ip.is_loopback:
        run(["nft", "add", "element", *NFT_TABLE, "allowed_tcp", "{ 22 }"])
    print(f"SSH enabled on {ip}:22 (key auth only, {len(lines)} key(s)"
          + (", saved on VICTORDATA" if saved else ", NOT saved: no persistent storage") + ")")


def cmd_ssh_stop():
    """Stop SSH and close port 22 on the LAN, but keep the keys (live and saved) for next time."""
    run(["systemctl", "disable", "--now", "ssh", "ssh.socket"])
    run(["nft", "delete", "element", *NFT_TABLE, "allowed_tcp", "{ 22 }"])
    if os.path.exists(SSHD_DROPIN):
        os.unlink(SSHD_DROPIN)
    print("SSH stopped. Your keys are kept; Enable SSH uses them again.")


def cmd_ssh_status():
    import re as _re
    listen = None
    if os.path.exists(SSHD_DROPIN):
        m = _re.search(r"^ListenAddress (\S+)", open(SSHD_DROPIN).read(), _re.M)
        listen = m.group(1) if m else None
    saved = saved_keys_path()
    print(json.dumps({"active": run(["systemctl", "is-active", "ssh"]).stdout.strip() == "active",
                      "authorized_keys": victorssh.count_keys(LIVE_KEYS), "listen": listen,
                      "keys_persistent": bool(saved and os.path.exists(saved)), "storage_persistent": bool(saved)}))


def cmd_revoke():
    run(["systemctl", "disable", "--now", "ssh", "ssh.socket"])
    for p in (LIVE_KEYS, SSHD_DROPIN, saved_keys_path(), "/etc/ssh/sshd_config.d/15-victor-mesh.conf"):
        if p and os.path.exists(p):
            os.unlink(p)
    run(["nft", "flush", "set", *NFT_TABLE, "allowed_tcp"])
    run(["nft", "flush", "set", *NFT_TABLE, "mesh_tcp"])
    print("remote access revoked: SSH disabled, keys removed (also from VICTORDATA), firewall closed. "
          "Run 'victor-ctl api rotate-key' to invalidate API clients.")


def cmd_reset_owner():
    require_current_password()
    run(["passwd", "-l", OWNER]); cmd_revoke()
    if os.path.isdir(ROOT_LINK):
        p = os.path.join(root_dir(), "secrets", "owner.shadow")
        if os.path.exists(p):
            os.unlink(p)
    print("owner password removed; first-run setup will run again at next login")


def cmd_owner_status():
    print("locked" if owner_hash().startswith(("!", "*")) or owner_hash() == "" else "set")


def cmd_access_apply():
    if os.path.isdir(ROOT_LINK):
        p = os.path.join(root_dir(), "secrets", "owner.shadow")
        h = (read_json(p, {}) or {}).get("hash")
        if h and h.startswith("$6$"):
            run(["usermod", "-p", h, OWNER]); run(["usermod", "-aG", "sudo", OWNER])
            print("owner credentials restored from the data partition")
    n = restore_ssh_keys()
    if n:
        print(f"{n} SSH key(s) restored from the data partition (SSH itself stays off until you enable it)")


def cmd_smart(dev):
    """Read-only SMART health of one local disk (partition paths are mapped to their disk). Never writes."""
    try:
        print(json.dumps(diskhealth.collect_smart(dev)))
    except ValueError as e:
        die(str(e))


INPUT_ENV = "/etc/default/victor-input"
INPUT_UNIT = "victor-input.service"


def cmd_input_enable(bind, port):
    if not port.isdigit() or not 1024 <= int(port) <= 65535:
        die("port must be 1024-65535")
    import ipaddress
    try:
        ip = ipaddress.ip_address(bind)
    except ValueError:
        if bind not in ("0.0.0.0", "::"):
            die("bind must be an IP address")
        ip = None
    os.makedirs(os.path.dirname(INPUT_ENV), exist_ok=True)
    with open(INPUT_ENV, "w") as f:
        f.write(f"VICTOR_INPUT_BIND={bind}\nVICTOR_INPUT_PORT={port}\n")
    os.chmod(INPUT_ENV, 0o644)
    r = run(["systemctl", "start", INPUT_UNIT])
    if r.returncode != 0:
        die("victor-input failed to start: " + (r.stderr or r.stdout).strip())
    loopback = ip is not None and ip.is_loopback
    if not loopback:
        _fw_open(port)
    print(json.dumps({"ok": True, "running": True, "bind": bind, "port": int(port), "enabled_on_boot": False,
                      "firewall_note": "TCP %s is open in nftables only while this service is on." % port}))


def _fw_open(port):
    r = run(["nft", "add", "element", *NFT_TABLE, "allowed_tcp", f"{{ {int(port)} }}"])
    if r.returncode:
        die("nft failed: " + r.stderr.strip())


def _fw_close(port):
    run(["nft", "delete", "element", *NFT_TABLE, "allowed_tcp", f"{{ {int(port)} }}"])


def _input_port():
    try:
        for line in open(INPUT_ENV):
            if line.startswith("VICTOR_INPUT_PORT="):
                return line.split("=", 1)[1].strip()
    except OSError:
        pass
    return "8473"


def cmd_input_disable():
    run(["systemctl", "stop", INPUT_UNIT])
    _fw_close(_input_port())
    print(json.dumps({"ok": True, "running": False, "message": "Wi-Fi input is off and the firewall port is closed."}))


def cmd_input_status():
    active = run(["systemctl", "is-active", INPUT_UNIT]).stdout.strip()
    enabled = run(["systemctl", "is-enabled", INPUT_UNIT]).stdout.strip()
    print(json.dumps({"running": active == "active", "boot": enabled, "default_off": True, "port": int(_input_port())}))


def _bt(args):
    r = run(["/usr/local/bin/victor-bt-pair", *args], timeout=30)
    if r.returncode != 0:
        die((r.stderr or r.stdout).strip() or "victor-bt-pair failed")
    print(r.stdout, end="" if r.stdout.endswith("\n") else "\n")


def cmd_bt_start():
    _bt(["start"])


def cmd_bt_confirm():
    _bt(["confirm"])


def cmd_bt_cancel():
    _bt(["cancel"])


def cmd_bt_status():
    _bt(["status"])


def cmd_bt_list():
    _bt(["list"])


def cmd_bt_unpair(mac):
    _bt(["unpair", mac])


VERBS = {"storage-mount": (cmd_mount, 1), "storage-auto": (cmd_auto, 0), "storage-session": (cmd_session, 0),
         "storage-check": (cmd_check, 0), "storage-repair": (cmd_repair, 0), "fw-sync": (cmd_fw_sync, 3),
         "set-password": (cmd_password, 0), "ssh-enable": (cmd_ssh_enable, 2), "ssh-stop": (cmd_ssh_stop, 0), "ssh-status": (cmd_ssh_status, 0), "revoke": (cmd_revoke, 0),
         "reset-owner": (cmd_reset_owner, 0), "owner-status": (cmd_owner_status, 0), "access-apply": (cmd_access_apply, 0), "smart": (cmd_smart, 1), "input-enable": (cmd_input_enable, 2), "input-disable": (cmd_input_disable, 0), "input-status": (cmd_input_status, 0), "bt-start": (cmd_bt_start, 0), "bt-confirm": (cmd_bt_confirm, 0), "bt-cancel": (cmd_bt_cancel, 0), "bt-status": (cmd_bt_status, 0), "bt-list": (cmd_bt_list, 0), "bt-unpair": (cmd_bt_unpair, 1),
         "hotspot-fw": (cmd_hotspot_fw, 2)}

if __name__ == "__main__":
    if os.geteuid() != 0:
        die("must run as root via sudo")
    if len(sys.argv) < 2 or sys.argv[1] not in VERBS:
        die("verbs: " + ", ".join(VERBS))
    fn, n = VERBS[sys.argv[1]]
    if len(sys.argv) - 2 != n:
        die(f"{sys.argv[1]} takes {n} argument(s)")
    try:
        fn(*sys.argv[2:])
    except VictorError as e:
        die(str(e))
