#!/usr/bin/env python3
"""victor-owner-setup: the owner's credentials, decided at the PHYSICAL CONSOLE. Root only.

Not in sudoers and mode 0700: no process running as the owner (browser, model server, anything the owner starts) can call it.
It is started by victor-owner-console.service on tty1 before the graphical login, so the person typing is the person at the
machine.

  approve    A data drive offers saved credentials (owner password hash, SSH keys) that this machine has not approved.
             They are trusted only after the owner types the password they belong to (audit F-10). Skipping leaves the
             drive as plain storage that never touches accounts, sudo or SSH keys.
  console    approve, then, while the owner account is still locked, set the FIRST owner password (audit F-13).
             `console --require` (the Pi headless wizard) does not allow skipping and does not time out.

The first password can be set nowhere else: `victor-priv set-password` refuses while the account is locked, because it is
callable (via sudo) by every process running as the owner. This tool is reachable only from the physical console.
Recovery if the password is lost: docs/MANUAL.md ("Lost password").
"""
import json, os, pwd, select, subprocess, sys, termios
sys.path.insert(0, "/usr/local/lib/victorlinux")
from victorlib import ownertrust
from victorlib.common import run

OWNER = ownertrust.OWNER
PRIV = "/usr/local/lib/victorlinux/victor-priv"
ATTEMPTS = 3
DEFAULT_TIMEOUT = 300


class Console:
    """Prompts on stdin/stdout. A timeout or end of input counts as 'skip', never as consent."""

    def __init__(self, timeout=DEFAULT_TIMEOUT, stdin=None, stdout=None):
        self.timeout, self.stdin, self.stdout = timeout, stdin or sys.stdin, stdout or sys.stdout

    def say(self, text=""):
        print(text, file=self.stdout, flush=True)

    def ask(self, prompt, secret=False):
        self.stdout.write(prompt); self.stdout.flush()
        fd = None
        try:
            fd = self.stdin.fileno() if self.stdin.isatty() else None
        except (OSError, ValueError, AttributeError):
            fd = None
        old = None
        try:
            if fd is not None:
                if secret:
                    old = termios.tcgetattr(fd)
                    new = termios.tcgetattr(fd); new[3] &= ~termios.ECHO
                    termios.tcsetattr(fd, termios.TCSADRAIN, new)
                if self.timeout and not select.select([self.stdin], [], [], self.timeout)[0]:
                    self.say("\n(timed out; nothing was changed)")
                    return None
            line = self.stdin.readline()
        finally:
            if old is not None:
                termios.tcsetattr(fd, termios.TCSADRAIN, old)
                self.stdout.write("\n"); self.stdout.flush()
        if line == "":
            return None
        return line.rstrip("\n")


def owner_ids():
    p = pwd.getpwnam(OWNER)
    return p.pw_uid, p.pw_gid


def describe(drive):
    r = run(["findmnt", "-n", "-o", "SOURCE", "--mountpoint", drive["mountpoint"]])
    dev = r.stdout.strip()
    extra = ""
    if dev:
        i = run(["lsblk", "-dn", "-o", "LABEL,SIZE,MODEL", dev]).stdout.strip()
        extra = f" ({i})" if i else ""
    return f"UUID {drive['uuid']}{extra}"


def switch_to_console():
    run(["chvt", "1"])


def approve(con, run_priv=None):
    """Returns 0 when there is nothing to do or the drive was approved, 1 when the owner declined/failed."""
    drive = ownertrust.current_drive()
    if not drive:
        return 0
    offered = ownertrust.inspect(drive, ownertrust.load_key())
    held = [n for n, (s, _) in offered.items() if s == "unapproved"]
    if not held:
        return 0
    drive_text = ownertrust.peek(drive, ownertrust.OWNER_SHADOW) if ownertrust.OWNER_SHADOW in held else None
    drive_hash = ownertrust.hash_text_of(drive_text) if drive_text else None
    cur = None if ownertrust.owner_locked() else ownertrust.owner_hash()
    if not drive_hash and not (cur and ownertrust.valid_hash(cur)):
        return 1                      # nothing to prove against: the drive stays plain storage (never a way to unlock)
    switch_to_console()
    con.say("")
    con.say("=" * 70)
    con.say(" VictorLinux: the data drive holds saved credentials this machine has not approved")
    con.say(f" Drive: {describe(drive)}")
    con.say(f" Holds: {', '.join(held)}")
    con.say(" Nothing from it is applied (no password, no sudo, no SSH keys) unless you approve.")
    con.say(" To approve, type the owner password that belongs to this drive.")
    con.say(" Press Enter to skip: the drive then works as plain storage only.")
    con.say("=" * 70)
    which = None
    for _ in range(ATTEMPTS):
        pw = con.ask("Owner password (Enter to skip): ", secret=True)
        if not pw:
            con.say("Skipped. The drive stays plain storage.")
            return 1
        if drive_hash and ownertrust.verify_password(drive_hash, pw):
            which = "drive"; break
        if cur and ownertrust.valid_hash(cur) and ownertrust.verify_password(cur, pw):
            which = "current"; break
        con.say("That password does not match.")
    if not which:
        con.say("Not approved. The drive stays plain storage.")
        return 1
    uid, gid = owner_ids()
    key = ownertrust.load_key(create=True)
    try:
        if which == "drive":
            ownertrust.seal(drive, ownertrust.OWNER_SHADOW, drive_text, os.geteuid(), os.getegid(), key)
        if ownertrust.SSH_KEYS in held:
            ownertrust.seal(drive, ownertrust.SSH_KEYS, ownertrust.peek(drive, ownertrust.SSH_KEYS) or "", uid, gid, key)
    except (ownertrust.TrustError, OSError) as e:
        con.say(f"Could not record the approval ({e}). The drive stays plain storage this boot.")
        return 1
    out = (run_priv or (lambda: run([PRIV, "access-apply"])))()
    con.say("Approved. " + ((getattr(out, "stdout", "") or "").strip()))
    return 0


MIN_LEN = 8


def make_hash(password):
    h = run(["openssl", "passwd", "-6", "-stdin"], input=password + "\n").stdout.strip()
    if not ownertrust.valid_hash(h):
        raise ownertrust.TrustError("hashing failed")
    return h


def apply_password(password, run_cmd=None):
    """Set the owner's password, give the owner sudo (password-gated) and keep the hash on the data drive, sealed."""
    run_cmd = run_cmd or run
    h = make_hash(password)
    r = run_cmd(["usermod", "-p", h, OWNER])
    if getattr(r, "returncode", 0):
        raise ownertrust.TrustError("could not set the password: " + (getattr(r, "stderr", "") or "").strip())
    run_cmd(["usermod", "-aG", "sudo", OWNER])
    note = ""
    drive = ownertrust.current_drive()
    if drive:
        try:
            ownertrust.seal(drive, ownertrust.OWNER_SHADOW, json.dumps({"hash": h}), os.geteuid(), os.getegid())
            note = " It is saved on the data drive (sealed by this machine)."
        except (ownertrust.TrustError, OSError) as e:
            note = f" It could not be saved on the data drive ({e}); you will be asked again next boot."
    return note


def first_password(con, require=False):
    """0 when the account has (or just got) a password, 1 when the owner skipped, 2 on an error."""
    if not ownertrust.owner_locked():
        return 0
    switch_to_console()
    con.say("")
    con.say("=" * 70)
    con.say(" VictorLinux: choose your owner password (login name: victor)")
    con.say(" There is no default password. This console is the only place the FIRST password can be set,")
    con.say(" so nothing running inside the desktop can set it for you.")
    con.say(f" At least {MIN_LEN} characters. It is used for sudo and stored as a hash, never in clear text.")
    if not require:
        con.say(" Press Enter to skip: the account stays locked (no sudo); this is asked again at the next boot.")
    con.say("=" * 70)
    tries = 0
    while require or tries < 5:
        tries += 1
        p1 = con.ask("New owner password: ", secret=True)
        if p1 is None or (p1 == "" and not require):
            con.say("Skipped. The owner account stays locked.")
            return 1
        if p1 == "":
            con.say("A password is required here.")
            continue
        if len(p1) < MIN_LEN:
            con.say(f"Too short: use at least {MIN_LEN} characters.")
            continue
        p2 = con.ask("Repeat the password: ", secret=True)
        if p2 is None:
            con.say("Skipped. The owner account stays locked.")
            return 1
        if p1 != p2:
            con.say("The two entries differ. Try again.")
            continue
        try:
            note = apply_password(p1)
        except (ownertrust.TrustError, OSError) as e:
            con.say(f"Error: {e}")
            return 2
        con.say("Owner password set." + note + " SSH stays OFF until you enable it in the Control Center.")
        return 0
    con.say("Too many attempts; the account stays locked. Reboot to try again.")
    return 1


def main(argv):
    if os.geteuid() != 0:
        print("victor-owner-setup must run as root on the console", file=sys.stderr)
        return 2
    if os.environ.get("SUDO_USER") or os.environ.get("SUDO_UID"):
        print("victor-owner-setup refuses to run through sudo", file=sys.stderr)
        return 2
    args = argv[1:]
    cmd = args[0] if args else "console"
    timeout = DEFAULT_TIMEOUT
    if "--timeout" in args:
        timeout = int(args[args.index("--timeout") + 1])
    if cmd not in ("approve", "console"):
        print(__doc__, file=sys.stderr)
        return 2
    require = "--require" in args
    con = Console(timeout=0 if require else timeout)
    approve(con)                   # declining is a normal outcome, never a failed boot
    if cmd == "approve":
        return 0
    rc = first_password(con, require)
    return 2 if (rc == 2 or (require and rc)) else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
