#!/usr/bin/env python3
"""victor-rustdeskv-priv: the root half of the RustDeskV host (run via `sudo -n`). Fixed verbs, strict validation.

Verbs: status | check | setup (owner password on stdin, one line) | apply | mount | umount | restore | disable | reset.
It never takes a command, path or flag from the caller and never prints or stores the password.
There is no default password: until `setup` succeeds, victor-rustdeskv.service does not start at all.
"""
import json
import os
import shutil
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import victorrustdeskv as rv  # noqa: E402

try:                                   # Arch keeps safefs next to the helpers, the Debian edition inside victorlib/
    import safefs  # noqa: E402
except ImportError:                    # pragma: no cover
    from victorlib import safefs  # noqa: E402


def die(msg, code=2):
    print(msg, file=sys.stderr)
    sys.exit(code)


def run(cmd, timeout=30, **kw):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, **kw)
    except FileNotFoundError:
        return subprocess.CompletedProcess(cmd, 127, "", f"{cmd[0]} not found")
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(cmd, 124, "", f"{cmd[0]} timed out")


def installed():
    return os.access(rv.BIN, os.X_OK)


def rd(*args, timeout=15):
    return run([rv.BIN, *args], timeout=timeout)


def wipe_password(text, pw):
    return text.replace(pw, "***") if pw else text


def persist_base():
    """Persistent folder for this feature, or None in a temporary session. The drive is not trusted: the folder is opened
    without following a symlink and must be owned by root (a planted link or foreign-owned folder is refused)."""
    base, persistent = rv.persist_dir()
    return base if persistent else None


def open_base(create=True):
    base = persist_base()
    if not base:
        return None
    try:
        return safefs.open_dir(base, uid=0, create=create, mode=0o700)
    except FileNotFoundError:
        return None
    except safefs.UnsafePath as e:
        die(f"refusing to use the persistent RustDeskV folder: {e}")


def write_marker_state():
    os.makedirs(rv.STATE_DIR, mode=0o700, exist_ok=True)
    with open(rv.MARKER, "w") as f:
        f.write("1\n")


def write_marker_persistent():
    dfd = open_base()
    if dfd is None:
        return False
    try:
        safefs.write_file(dfd, "enabled", "1\n", uid=0, gid=0, mode=0o600)
    finally:
        os.close(dfd)
    return True


def open_cfg(dfd):
    try:
        os.mkdir("config", 0o700, dir_fd=dfd)
    except FileExistsError:
        pass
    try:
        fd = os.open("config", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=dfd)
    except OSError as e:
        die(f"refusing to use the persistent RustDeskV config folder: {e.strerror}")
    st = os.fstat(fd)
    if st.st_uid != os.geteuid():                       # we run as root: a folder owned by anyone else is not ours
        os.close(fd)
        die("refusing to use the persistent RustDeskV config folder: not owned by root")
    os.fchmod(fd, 0o700)
    return fd


def cmd_mount():
    """Keep the root-run service's config (ID, keys, password hash) on persistent storage when there is some."""
    os.makedirs(rv.CONFIG_DIR, mode=0o700, exist_ok=True)
    dfd = open_base()
    if dfd is None:
        return                                           # temporary session: RAM only, set up again after power-off
    try:
        cfd = open_cfg(dfd)
        try:
            if run(["mountpoint", "-q", rv.CONFIG_DIR]).returncode == 0:
                return
            # bind the directory we just opened (by fd), not a path that could be swapped for a symlink meanwhile
            r = run(["mount", "--bind", f"/proc/self/fd/{cfd}", rv.CONFIG_DIR], pass_fds=(cfd,))
            if r.returncode != 0:
                die("could not keep the RustDeskV config on persistent storage: " + (r.stderr or "").strip()[-200:])
        finally:
            os.close(cfd)
    finally:
        os.close(dfd)


def cmd_umount():
    if run(["mountpoint", "-q", rv.CONFIG_DIR]).returncode == 0:
        run(["umount", rv.CONFIG_DIR])


def checked_relay():
    try:
        return rv.require_private_relay(rv.load_relay())
    except (rv.SetupError, OSError) as e:
        die(f"relay config rejected: {e}; configure {rv.RELAY_CONF} first")


def cmd_check():
    checked_relay()


def cmd_apply():
    """Fail closed: if the policy cannot be confirmed, the service stops (ExecStartPost fails)."""
    relay = checked_relay()
    wanted = list(rv.POLICY) + rv.relay_options(relay)
    deadline = time.time() + 45
    last = ""
    while time.time() < deadline:
        ok = True
        for k, v in wanted:
            r = rd("--option", k, v)
            got = rd("--option", k)
            if got.returncode != 0 or got.stdout.strip() != v:
                ok = False
                last = (got.stdout or got.stderr).strip()[-200:]
                break
        if ok:
            print("policy applied: permanent password only, no click-to-accept, custom server")
            return
        time.sleep(1)
    die("RustDeskV did not accept the access policy in time; refusing to leave it running. " + last)


def cmd_setup():
    if not installed():
        die("RustDeskV is not installed in this image (it was built with it turned off).")
    pw = sys.stdin.readline().rstrip("\n")
    try:
        rv.validate_password(pw)
    except rv.SetupError as e:
        die(str(e))
    checked_relay()
    write_marker_state()
    r = run(["systemctl", "start", rv.UNIT], timeout=90)
    if r.returncode != 0:
        os.unlink(rv.MARKER)
        log = run(["journalctl", "-u", rv.UNIT, "-n", "8", "--no-pager"]).stdout
        die("could not start the RustDeskV service: " + wipe_password((r.stderr or log).strip()[-400:], pw))
    out = None
    for _ in range(20):
        out = rd("--password", pw)
        if "Done!" in (out.stdout or ""):
            break
        time.sleep(1)
    if not out or "Done!" not in (out.stdout or ""):
        run(["systemctl", "stop", rv.UNIT], timeout=60)
        if os.path.exists(rv.MARKER):
            os.unlink(rv.MARKER)
        die("RustDeskV refused the password: " + wipe_password(((out.stdout or "") + (out.stderr or "")).strip()[-300:], pw))
    saved = write_marker_persistent()
    run(["systemctl", "enable", rv.UNIT])
    print("RustDeskV host is on. Unattended access works only with the password you just set."
          + ("" if saved else " This is a temporary session: run setup again after the next boot."))


def cmd_restore():
    dfd = open_base(create=False)
    if dfd is None:
        return
    try:
        if safefs.read_file(dfd, "enabled", limit=16) is not None:
            write_marker_state()
    finally:
        os.close(dfd)


def cmd_disable():
    run(["systemctl", "stop", rv.UNIT], timeout=60)
    run(["systemctl", "enable", rv.UNIT])                # stays enabled; the missing marker is what keeps it from starting
    if os.path.exists(rv.MARKER):
        os.unlink(rv.MARKER)
    dfd = open_base(create=False)
    if dfd is not None:
        try:
            os.unlink("enabled", dir_fd=dfd)
        except FileNotFoundError:
            pass
        finally:
            os.close(dfd)
    print("RustDeskV host stopped. It will not start again until you run setup.")


def cmd_reset():
    cmd_disable()
    cmd_umount()
    dfd = open_base(create=False)
    if dfd is not None:
        try:
            shutil.rmtree("config", ignore_errors=True, dir_fd=dfd)    # symlink-safe: never follows a link out of the folder
        finally:
            os.close(dfd)
    if os.path.isdir(rv.CONFIG_DIR) and not os.path.islink(rv.CONFIG_DIR):
        shutil.rmtree(rv.CONFIG_DIR, ignore_errors=True)
    print("RustDeskV identity and password removed. A new ID is made at the next setup.")


def cmd_status():
    active = run(["systemctl", "is-active", rv.UNIT], timeout=10).stdout.strip()
    enabled = run(["systemctl", "is-enabled", rv.UNIT], timeout=10).stdout.strip()
    try:
        relay = rv.load_relay()
        relay_state = "custom"
        relay_err = ""
        try:
            rv.require_private_relay(relay)
        except rv.SetupError as e:
            relay_state, relay_err = "unconfigured", str(e)
    except (rv.SetupError, OSError) as e:
        relay_state, relay_err = "invalid", str(e)
    persistent = persist_base() is not None
    rid = ""
    if active == "active":
        rid = rd("--get-id").stdout.strip()
    print(json.dumps({"installed": installed(), "unit_enabled": enabled, "unit_active": active,
                      "setup_done": os.path.exists(rv.MARKER), "servers": relay_state, "relay_error": relay_err,
                      "config_persistent": persistent, "id": rid, "policy": dict(rv.POLICY)}))


VERBS = {"status": cmd_status, "setup": cmd_setup, "check": cmd_check, "apply": cmd_apply, "mount": cmd_mount, "umount": cmd_umount,
         "restore": cmd_restore, "disable": cmd_disable, "reset": cmd_reset}


def main(argv):
    if len(argv) != 2 or argv[1] not in VERBS:
        die("usage: victor-rustdeskv-priv " + "|".join(VERBS))
    if os.geteuid() != 0 and "VICTOR_RUSTDESKV_TEST" not in os.environ:
        die("must run as root (via sudo)")
    VERBS[argv[1]]()


if __name__ == "__main__":
    main(sys.argv)
