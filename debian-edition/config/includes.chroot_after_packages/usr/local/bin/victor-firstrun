#!/usr/bin/env python3
"""First-run notice. The owner's first password is set on the physical console while the system boots (victor-owner-setup,
root only), never from this window: any program running as the owner could otherwise set it and become root (audit F-13)."""
import subprocess, sys, tkinter as tk
from tkinter import messagebox, ttk
PRIV = ["sudo", "-n", "/usr/local/lib/victorlinux/victor-priv"]

def status():
    return subprocess.run([*PRIV, "owner-status"], capture_output=True, text=True).stdout.strip()

if status() != "locked":
    sys.exit(0)
root = tk.Tk(); root.title("VictorLinux first-run setup")
root.configure(bg="#0b0f1a")
root.option_add("*background", "#0b0f1a"); root.option_add("*foreground", "#e8eef9")
root.option_add("*selectBackground", "#00e5ff"); root.option_add("*selectForeground", "#05121a"); root.option_add("*insertBackground", "#e8eef9")
style = ttk.Style(root); style.theme_use("clam")
style.configure(".", background="#0b0f1a", foreground="#e8eef9", fieldbackground="#0b0f1a")
style.configure("TButton", padding=(14, 8))
style.configure("TButton", background="#00e5ff", foreground="#05121a"); style.map("TButton", background=[("active", "#5cf0ff")])  # brand cyan primary action
style.configure("TEntry", fieldbackground="#0b0f1a", foreground="#e8eef9", insertcolor="#00e5ff", bordercolor="#33406a")
ttk.Label(root, wraplength=440, padding=8, text="Welcome to VictorLinux. No owner password is set yet, so sudo is unavailable.\n\n"
          "Your first password can only be set on the text console while the computer boots, before this desktop appears: "
          "reboot and answer the prompt on the black screen (press Enter there to skip). It cannot be set from inside the "
          "desktop, because any program running here could then take over the machine.\n\n"
          "The desktop and the Control Center work without it. If you already set a password and keep it on your data drive, "
          "the console asks you to type it once per boot to approve the drive.").pack()
ttk.Button(root, text="OK", command=root.destroy).pack(pady=8)
root.mainloop()
