#!/usr/bin/env python3
"""VictorLinux Control Center (Tk). Thin GUI: every action is a `victor-ctl` call, so everything is scriptable."""
import json, math, os, subprocess, sys, threading, tkinter as tk
from tkinter import ttk, filedialog, messagebox, scrolledtext

CTL = "/usr/local/bin/victor-ctl"


def ctl(*args, timeout=600, stdin=None):
    p = subprocess.run([CTL, *args], capture_output=True, text=True, timeout=timeout, input=stdin)
    if p.returncode != 0:
        raise RuntimeError(p.stderr.strip() or p.stdout.strip() or f"exit {p.returncode}")
    try:
        return json.loads(p.stdout)
    except ValueError:
        return p.stdout.strip()


# VictorLinux brand palette (same as the Arch web Control Center): background #0B0F1A,
# primary accent cyan #00E5FF, secondary accent magenta #FF2BD6. Always dark; every pair meets WCAG AA.
PALETTES = {
    "dark": {"bg": "#0b0f1a", "panel": "#161e31", "card": "#111727", "fg": "#e8eef9", "muted": "#9ba8c3",
             "accent": "#00e5ff", "on_accent": "#05121a", "accent2": "#ff2bd6", "entry": "#0b0f1a", "sel": "#1d2740",
             "border": "#33406a", "ok": "#3ee6a8", "warn": "#ffc857", "bad": "#ff6b88"},
}


class App(tk.Tk):
    def apply_theme(self, mode):
        P = PALETTES["dark"]; self.mode = "dark"
        st = ttk.Style(self); st.theme_use("clam")
        st.configure(".", background=P["bg"], foreground=P["fg"], fieldbackground=P["entry"], bordercolor=P["panel"], lightcolor=P["panel"], darkcolor=P["panel"])
        st.configure("TFrame", background=P["bg"]); st.configure("TLabel", background=P["bg"], foreground=P["fg"])
        st.configure("TLabelframe", background=P["bg"], foreground=P["fg"]); st.configure("TLabelframe.Label", background=P["bg"], foreground=P["fg"])
        st.configure("TButton", background=P["panel"], foreground=P["fg"], padding=(14, 9), bordercolor=P["border"], focuscolor=P["accent"])
        st.map("TButton", background=[("disabled", P["card"]), ("active", P["sel"])], foreground=[("disabled", P["muted"])], bordercolor=[("focus", P["accent"]), ("active", P["accent"])])
        # Primary action: cyan with dark text (12:1 contrast). Focus ring is cyan on every button.
        st.configure("Accent.TButton", background=P["accent"], foreground=P["on_accent"], bordercolor=P["accent"], font=("Sans", 10, "bold"))
        st.map("Accent.TButton", background=[("disabled", P["sel"]), ("active", "#5cf0ff")], foreground=[("disabled", P["muted"])])
        st.configure("Danger.TButton", background="#2a1222", foreground="#ff9db1", bordercolor="#6e2c46")
        st.map("Danger.TButton", background=[("active", "#3a1830")], bordercolor=[("focus", P["accent"]), ("active", P["bad"])])
        st.configure("Card.TFrame", background=P["card"], bordercolor=P["border"], relief="solid", borderwidth=1)
        st.configure("TileKey.TLabel", background=P["card"], foreground=P["muted"], font=("Sans", 8, "bold"))
        st.configure("TileVal.TLabel", background=P["card"], foreground=P["fg"], font=("Sans", 13, "bold"))
        st.configure("TileSub.TLabel", background=P["card"], foreground=P["muted"], font=("Sans", 9))
        st.configure("Brand.TLabel", background=P["bg"], foreground=P["fg"], font=("Sans", 22, "bold"))
        st.configure("Eyebrow.TLabel", background=P["bg"], foreground=P["accent2"], font=("Sans", 9, "bold"))
        st.configure("Status.TLabel", background=P["card"], foreground=P["muted"], padding=(10, 4))
        for k in ("ok", "warn", "bad"):
            st.configure(f"Status{k.title()}.TLabel", background=P["card"], foreground=P[k], padding=(10, 4))
        st.configure("TScrollbar", background=P["panel"], troughcolor=P["bg"], arrowcolor=P["fg"])
        st.configure("TCombobox", fieldbackground=P["entry"], foreground=P["fg"], arrowcolor=P["accent"])
        st.configure("TCheckbutton", background=P["bg"], foreground=P["fg"]); st.map("TCheckbutton", background=[("active", P["bg"])])
        st.configure("TEntry", fieldbackground=P["entry"], foreground=P["fg"], insertcolor=P["accent"], bordercolor=P["border"])
        st.map("TEntry", bordercolor=[("focus", P["accent"])], lightcolor=[("focus", P["accent"])])
        st.configure("TNotebook", background=P["bg"]); st.configure("TNotebook.Tab", background=P["panel"], foreground=P["fg"], padding=(10, 4))
        st.map("TNotebook.Tab", background=[("selected", P["accent"])], foreground=[("selected", P["on_accent"])])
        self.configure(bg=P["bg"])
        self.option_add("*Listbox.background", P["entry"]); self.option_add("*Listbox.foreground", P["fg"])
        self.option_add("*Listbox.selectBackground", P["accent"]); self.option_add("*Listbox.selectForeground", P["on_accent"])
        self.option_add("*Text.background", P["entry"]); self.option_add("*Text.foreground", P["fg"])
        self.option_add("*highlightColor", P["accent"]); self.option_add("*highlightBackground", P["bg"])
        # Message boxes and file dialogs inherit these (no white dialogs).
        self.option_add("*background", P["bg"]); self.option_add("*foreground", P["fg"])
        self.option_add("*selectBackground", P["accent"]); self.option_add("*selectForeground", P["on_accent"])
        self.option_add("*insertBackground", P["accent"]); self.option_add("*activeBackground", P["sel"]); self.option_add("*activeForeground", P["fg"])
        for w in getattr(self, "_themed", []):
            try:
                w.configure(bg=P["entry"], fg=P["fg"], insertbackground=P["accent"], highlightthickness=1,
                            highlightbackground=P["border"], highlightcolor=P["accent"], relief="flat")
                if isinstance(w, tk.Listbox): w.configure(selectbackground=P["accent"], selectforeground=P["on_accent"])
            except tk.TclError:
                pass

    def rounded_tabs(self):
        # Nine-slice tab backgrounds preserve round corners as labels grow.
        def image(color):
            img = tk.PhotoImage(master=self, width=40, height=36)
            radius = 13
            for y in range(36):
                dy = max(radius - y, y - (35 - radius), 0)
                inset = max(0, math.ceil(radius - math.sqrt(max(0, radius * radius - dy * dy))))
                img.put(color, to=(inset, y, 40 - inset, y + 1))
            return img
        P = PALETTES["dark"]
        self._tab_images = [image(c) for c in (P["panel"], P["accent"], P["sel"])]
        style = ttk.Style(self)
        style.element_create("Victor.Tab", "image", self._tab_images[0],
                             ("selected", self._tab_images[1]), ("active", self._tab_images[2]),
                             border=(14, 13, 14, 13), sticky="nsew")
        style.layout("TNotebook.Tab", [("Victor.Tab", {"sticky": "nsew", "children": [
            ("Notebook.padding", {"side": "top", "sticky": "nsew", "children": [
                ("Notebook.label", {"side": "top", "sticky": ""})]})]})])

    def __init__(self):
        super().__init__()
        self._themed = []
        self.apply_theme("dark"); self.rounded_tabs()
        self.title("VictorLinux Control Center")
        self.geometry("1040x760"); self.minsize(900, 640)
        header = ttk.Frame(self, padding=(22, 16, 22, 6)); header.pack(fill="x")
        ttk.Label(header, text="VICTORIOUS FRAMEWORK  ·  LOCAL AI WORKSPACE", style="Eyebrow.TLabel").pack(anchor="w")
        ttk.Label(header, text="VictorLinux", style="Brand.TLabel").pack(anchor="w")
        tk.Frame(self, height=2, bg=PALETTES["dark"]["accent"]).pack(fill="x", padx=22)
        self.status_var = tk.StringVar(value="starting...")
        self.status_label = ttk.Label(self, textvariable=self.status_var, anchor="w", style="Status.TLabel")
        self.status_label.pack(fill="x", side="bottom")
        self.tiles = {}
        strip = ttk.Frame(self, padding=(18, 10, 18, 0)); strip.pack(fill="x")
        for i, (key, title) in enumerate((("model", "MODEL"), ("backend", "BACKEND"), ("api", "API"),
                                          ("storage", "STORAGE"), ("ram", "RAM"), ("vram", "VRAM"))):
            card = ttk.Frame(strip, style="Card.TFrame", padding=(12, 8)); card.grid(row=0, column=i, sticky="nsew", padx=4)
            strip.columnconfigure(i, weight=1, uniform="tile")
            ttk.Label(card, text=title, style="TileKey.TLabel").pack(anchor="w")
            v, sub = tk.StringVar(value="…"), tk.StringVar(value="loading")
            ttk.Label(card, textvariable=v, style="TileVal.TLabel").pack(anchor="w")
            ttk.Label(card, textvariable=sub, style="TileSub.TLabel", wraplength=140).pack(anchor="w")
            self.tiles[key] = (v, sub)
        self.nb = ttk.Notebook(self); self.nb.pack(fill="both", expand=True, padx=18, pady=12)
        self.tab_status(); self.tab_models(); self.tab_remote(); self.tab_phone(); self.tab_kali(); self.tab_fleet(); self.tab_storage(); self.tab_docs(); self.tab_diag()
        self.after(500, self.refresh)

    # ---- helpers
    def set_status(self, text, level=None):
        self.status_var.set(text)
        self.status_label.configure(style=f"Status{level.title()}.TLabel" if level else "Status.TLabel")

    def tile(self, key, value, sub=""):
        v, s = self.tiles[key]; v.set(value); s.set(sub)

    def bg(self, fn, done=None, busy="working..."):
        self.set_status("⏳ " + busy)
        def w():
            try:
                r = fn(); err = None
            except Exception as e:  # noqa
                r, err = None, str(e)
            self.after(0, lambda: self._done(r, err, done))
        threading.Thread(target=w, daemon=True).start()

    def _done(self, r, err, done):
        if err:
            self.set_status("error: " + err.splitlines()[0][:160] if err.strip() else "error", "bad"); messagebox.showerror("VictorLinux", err)
        else:
            self.set_status("ready", "ok")
            if done:
                done(r)

    def out(self, widget, text):
        widget.configure(state="normal"); widget.delete("1.0", "end"); widget.insert("end", text); widget.configure(state="disabled")

    def mkout(self, parent):
        t = scrolledtext.ScrolledText(parent, height=12, state="disabled", font="TkFixedFont"); t.pack(fill="both", expand=True, pady=4)
        self._themed.append(t); self.apply_theme(self.mode)
        return t

    # ---- Status
    def recommend(self):
        self.bg(lambda: ctl("hw", "recommend", timeout=90),
                lambda result: messagebox.showinfo("Model recommendations (estimates)",
                    result["note"] + "\n\n" + "\n".join(
                        f"{m['name']}: {m['fit']} (~{m['estimated_total']/2**30:.1f} GiB)" for m in result["models"])))

    def tab_status(self):
        f = ttk.Frame(self.nb, padding=8); self.nb.add(f, text="Status")
        self.st_text = self.mkout(f)
        b = ttk.Frame(f); b.pack(fill="x")
        for label, fn, style in (("Start inference", self.start, "Accent.TButton"),
                                 ("Stop inference", lambda: self.bg(lambda: ctl("llama", "stop"), lambda r: self.refresh()), "Danger.TButton"),
                                 ("Open local chat", self.open_chat, "TButton"), ("Terminal", lambda: subprocess.Popen(["xfce4-terminal"]), "TButton"),
                                 ("Refresh", self.refresh, "TButton")):
            ttk.Button(b, text=label, command=fn, style=style).pack(side="left", padx=3)
        ttk.Label(f, text="Image generation: optional pack, not installed in this image (see docs/PACKS.md).").pack(anchor="w", pady=4)

    def start(self):
        def done(r):
            msg = ""
            if r["backend"]["accelerated"]:
                msg = f"GPU backend: {r['backend']['reason']}"
            else:
                msg = f"CPU FALLBACK: {r['backend']['reason']}"
            if r["warnings"]:
                msg += "\n" + "\n".join(r["warnings"])
            messagebox.showinfo("Inference started", msg); self.refresh()
        self.bg(lambda: ctl("llama", "start"), done, "loading model...")

    def open_chat(self):
        subprocess.Popen(["/usr/local/bin/victor-chat"])

    def refresh(self):
        def get():
            d = {"hw": ctl("hw", "snapshot", timeout=90), "st": ctl("storage", "status"), "ll": ctl("llama", "status")}
            try:
                d["cfg"] = ctl("llama", "config")
            except Exception:  # noqa: config is optional for the overview
                d["cfg"] = {}
            return d
        def done(d):
            hw, st, ll = d["hw"], d["st"], d["ll"]
            self.update_tiles(hw, st, ll, d.get("cfg") or {})
            lines = [f"Storage : {st.get('state')} - {st.get('message')}"]
            u = st.get("usage")
            if u:
                lines.append(f"          {u['free']/2**30:.1f} GiB free of {u['total']/2**30:.1f} GiB at {u['root']}")
            ram = hw["ram"]; lines.append(f"RAM     : {ram['available']/2**30:.1f} GiB available / {ram['total']/2**30:.1f} GiB")
            for v in hw["sysfs_vram"]:
                lines.append(f"VRAM    : {v['vram_used']/2**30:.1f} / {v['vram_total']/2**30:.1f} GiB used ({v['card']}, busy {v['gpu_busy_percent']}%)")
            for g in hw["pci_gpus"]:
                lines.append(f"GPU     : {g['desc']}  [driver: {g['driver']}]")
            for dv in hw["llama_devices"]["devices"]:
                lines.append(f"llama.cpp device: {dv['id']} {dv['name']} ({dv['total_mib']} MiB, {dv['free_mib']} free)")
            perms = hw["permissions"]
            lines.append("Render nodes: " + (", ".join(f"{n['path']} rw={n['user_can_rw']}" for n in perms["render_nodes"]) or "NONE (no /dev/dri; GPU unusable)"))
            rt = ll.get("runtime")
            lines.append(f"Service : {'RUNNING' if ll['running'] else 'stopped'}" + (f" - model {rt['model']} on {rt['backend']['backend']} ({rt['backend']['reason']})" if ll["running"] and rt else ""))
            self.out(self.st_text, "\n".join(lines))
        self.bg(get, done, "refreshing...")

    def update_tiles(self, hw, st, ll, cfg):
        """Status overview strip: model, backend, API on/off + bind, storage, RAM, VRAM."""
        gib = lambda n: f"{n / 2**30:.1f} GiB"
        rt = ll.get("runtime") or {}
        model = (rt.get("model") if ll.get("running") else None) or cfg.get("model") or ""
        self.tile("model", os.path.basename(str(model)) or "None selected",
                  "loaded" if ll.get("running") else ("not loaded" if model else "pick one in Models"))
        be = (rt.get("backend") or {}) if ll.get("running") else {}
        name = str(be.get("backend") or cfg.get("backend") or "auto")
        self.tile("backend", {"cpu": "CPU", "vulkan": "Vulkan", "cuda": "CUDA", "hip": "HIP"}.get(name.lower(), name.upper()),
                  str(be.get("reason") or ("configured" if not ll.get("running") else ""))[:60])
        remote = bool((cfg.get("remote") or {}).get("enabled")) if isinstance(cfg.get("remote"), dict) else False
        bind, port = cfg.get("bind", "127.0.0.1"), cfg.get("port", "")
        self.tile("api", "On" if ll.get("running") else "Off", f"{bind}{':' + str(port) if port else ''} · {'remote' if remote else 'local only'}")
        u = st.get("usage") or {}
        self.tile("storage", str(st.get("state", "?")).capitalize(), f"{gib(u['free'])} free" if u.get("free") is not None else str(st.get("message", ""))[:60])
        ram = hw.get("ram") or {}
        if ram.get("total"):
            self.tile("ram", f"{gib(ram['total'] - ram['available'])} / {gib(ram['total'])}", f"{gib(ram['available'])} available")
        v = (hw.get("sysfs_vram") or [None])[0]
        self.tile("vram", f"{gib(v['vram_used'])} / {gib(v['vram_total'])}" if v else "No VRAM info", (v or {}).get("card", "CPU or shared memory"))

    # ---- Models
    def tab_models(self):
        f = ttk.Frame(self.nb, padding=8); self.nb.add(f, text="Models")
        self.model_list = tk.Listbox(f, height=7); self.model_list.pack(fill="x"); self._themed.append(self.model_list)
        row = ttk.Frame(f); row.pack(fill="x", pady=4)
        ttk.Button(row, text="Import .gguf...", command=self.import_model).pack(side="left", padx=3)
        ttk.Button(row, text="Select for inference", command=self.select_model).pack(side="left", padx=3)
        ttk.Button(row, text="Remove", command=self.remove_model).pack(side="left", padx=3)
        ttk.Button(row, text="Reload list", command=self.load_models).pack(side="left", padx=3)
        ttk.Button(row, text="Check integrity (hash)", command=self.hash_model).pack(side="left", padx=3)
        ttk.Button(row, text="Remember settings", command=lambda: self.bg(lambda: ctl("model", "remember", self._sel()),
                                                                          lambda r: self.models_msg.set(f"remembered for this model: {r}"))).pack(side="left", padx=3)
        ttk.Label(f, text="Optional SHA-256 to verify:").pack(anchor="w"); self.sha = ttk.Entry(f); self.sha.pack(fill="x")
        s = ttk.LabelFrame(f, text="Inference settings", padding=6); s.pack(fill="x", pady=6)
        self.vars = {k: tk.StringVar() for k in ("backend", "ctx", "mem_limit_gb", "sleep_idle_minutes")}
        self.jinja = tk.BooleanVar()
        for i, (k, lab) in enumerate((("backend", "Backend (auto/vulkan/cpu)"), ("ctx", "Context length"),
                                       ("mem_limit_gb", "RAM limit GiB (0=auto)"), ("sleep_idle_minutes", "Unload when idle (min)"))):
            ttk.Label(s, text=lab).grid(row=i, column=0, sticky="w"); ttk.Entry(s, textvariable=self.vars[k]).grid(row=i, column=1, sticky="ew")
        ttk.Checkbutton(s, text="Chat template / tool-call formatting (--jinja)", variable=self.jinja).grid(row=4, column=0, columnspan=2, sticky="w")
        ttk.Button(s, text="Apply (restart service to take effect)", command=self.apply_cfg).grid(row=5, column=0, columnspan=2, pady=4)
        self.models_msg = tk.StringVar(); ttk.Label(f, textvariable=self.models_msg, wraplength=800).pack(anchor="w")
        self.after(800, self.load_models)

    def load_models(self):
        def done(d):
            self.model_list.delete(0, "end")
            for m in d["models"]:
                self.model_list.insert("end", f"{m['name']}   ({m['size']/2**30:.2f} GiB)")
            self._models = d["models"]
            for k in self.vars: self.vars[k].set(str(d["cfg"][k]))
            self.jinja.set(bool(d["cfg"]["jinja"])); self.models_msg.set(f"selected: {d['cfg']['model'] or '(none)'}")
        self.bg(lambda: {"models": ctl("model", "list"), "cfg": ctl("llama", "config")}, done)

    def hash_model(self):
        n = self._sel()
        args = ["model", "hash", n] + (["--expected", self.sha.get().strip()] if self.sha.get().strip() else [])
        self.bg(lambda: ctl(*args, timeout=7200), lambda r: self.models_msg.set(f"{n}: {r[n]['label']} {r[n].get('sha256', '')}"),
                "hashing (reads the whole file)...")

    def _sel(self):
        i = self.model_list.curselection()
        if not i: raise RuntimeError("Select a model in the list first.")
        return self._models[i[0]]["name"]

    def import_model(self):
        p = filedialog.askopenfilename(title="Choose a GGUF model (USB drives appear under /media)", initialdir="/media" if os.path.isdir("/media") else "/",
                                        filetypes=[("GGUF models", "*.gguf")])
        if not p: return
        args = ["model", "import", p] + (["--sha256", self.sha.get().strip()] if self.sha.get().strip() else [])
        def done(r):
            messagebox.showinfo("Imported", f"{r['imported_to']}\nchecksum verified: {r['checksum_verified']}\nestimated memory: {r['estimate']['estimated_total']/2**30:.1f} GiB ({r['estimate']['note']})")
            self.load_models()
        self.bg(lambda: ctl(*args), done, "copying + validating...")

    def select_model(self):
        n = self._sel(); self.bg(lambda: ctl("model", "select", n), lambda r: self.load_models())

    def remove_model(self):
        n = self._sel()
        if messagebox.askyesno("Remove", f"Delete {n} from the data partition?"):
            self.bg(lambda: ctl("model", "remove", n), lambda r: self.load_models())

    def apply_cfg(self):
        sets = [f"{k}={v.get()}" for k, v in self.vars.items()] + [f"jinja={'1' if self.jinja.get() else '0'}"]
        self.bg(lambda: ctl("llama", "config", "--set", *sets), lambda r: self.models_msg.set("settings saved"))

    # ---- Remote
    def tab_remote(self):
        f = ttk.Frame(self.nb, padding=8); self.nb.add(f, text="Remote access")
        ttk.Label(f, wraplength=800, text="Default: the API listens on 127.0.0.1 only. To let DroidCommand-AI (or another client) connect, choose the "
                  "exact LAN/VPN address, keep TLS on, and restart the service. A key is always required for remote clients.").pack(anchor="w")
        self.rbind = tk.StringVar(value="127.0.0.1"); ttk.Label(f, text="Listen address").pack(anchor="w"); ttk.Entry(f, textvariable=self.rbind).pack(fill="x")
        self.rtls = tk.BooleanVar(value=True); ttk.Checkbutton(f, text="HTTPS (self-signed, pinned certificate)", variable=self.rtls).pack(anchor="w")
        self.rvpn = tk.BooleanVar(); ttk.Checkbutton(f, text="Allow plain HTTP ONLY because traffic is inside a private VPN (Tailscale/WireGuard)", variable=self.rvpn).pack(anchor="w")
        b = ttk.Frame(f); b.pack(fill="x", pady=4)
        for t, fn in (("Enable remote", self.remote_on), ("Disable (loopback)", self.remote_off), ("Show connection details", lambda: self.conn(False)),
                      ("Reveal key", self.reveal), ("Rotate key", self.rotate), ("Revoke ALL remote access", self.revoke), ("Self-test API", self.selftest)):
            ttk.Button(b, text=t, command=fn).pack(side="left", padx=2)
        self.remote_out = self.mkout(f)

    def remote_on(self):
        ip = self.rbind.get().strip()
        sets = [f"bind={ip}", "remote.enabled=1", f"remote.tls={'1' if self.rtls.get() else '0'}", f"remote.vpn_plain_http_ack={'1' if self.rvpn.get() else '0'}"]
        self.bg(lambda: ctl("llama", "config", "--set", *sets), lambda r: (self.out(self.remote_out, "Remote access enabled. Restart the service to apply."),))

    def remote_off(self):
        self.bg(lambda: ctl("llama", "config", "--set", "remote.enabled=0", "bind=127.0.0.1"), lambda r: self.out(self.remote_out, "Back to loopback only. Restart the service."))

    def conn(self, reveal):
        self.bg(lambda: ctl("api", "connection", *(["--reveal-key"] if reveal else [])), lambda r: self.out(self.remote_out, json.dumps(r, indent=2)))

    def reveal(self):
        if messagebox.askyesno("Reveal key", "Show the API key on screen?"): self.conn(True)

    def rotate(self):
        self.bg(lambda: ctl("api", "rotate-key"), lambda r: self.out(self.remote_out, r))

    def revoke(self):
        self.bg(lambda: subprocess.run(["sudo", "-n", "/usr/local/lib/victorlinux/victor-priv", "revoke"], capture_output=True, text=True).stdout,
                lambda r: self.out(self.remote_out, r))

    def selftest(self):
        self.bg(lambda: ctl("api", "selftest", timeout=900), lambda r: self.out(self.remote_out, json.dumps(r, indent=2)), "testing endpoint...")


    # ---- Phone as keyboard (Bluetooth, Wi-Fi, USB). Off by default.
    def tab_phone(self):
        f = ttk.Frame(self.nb, padding=8); self.nb.add(f, text="Phone keyboard")
        ttk.Label(f, wraplength=820, text="Use the Victorious Keyboard app (com.victorious.keyboard) as a keyboard and mouse for this PC. "
                  "Bluetooth and Wi-Fi input stay off until you turn them on. USB needs no PC software.").pack(anchor="w")
        ttk.Label(f, text="Bluetooth (standard HID keyboard and mouse)", font=("Sans", 11, "bold")).pack(anchor="w", pady=(12, 2))
        ttk.Label(f, wraplength=820, text="Makes this PC discoverable for 120 seconds, shows the passkey, and trusts the phone only after you confirm. "
                  "Does not enable Bluetooth on boot.").pack(anchor="w")
        b = ttk.Frame(f); b.pack(fill="x", pady=4)
        for label, fn in (("Pair phone (Bluetooth)", self.bt_start), ("Confirm passkey", self.bt_confirm),
                          ("Cancel", self.bt_cancel), ("List / refresh", self.bt_refresh)):
            ttk.Button(b, text=label, command=fn).pack(side="left", padx=2)
        row = ttk.Frame(f); row.pack(fill="x", pady=2)
        self.bt_mac = tk.StringVar()
        ttk.Label(row, text="Unpair address").pack(side="left")
        e = ttk.Entry(row, textvariable=self.bt_mac, width=22); e.pack(side="left", padx=4)
        ttk.Button(row, text="Unpair", command=self.bt_unpair).pack(side="left")
        self.bt_out = self.mkout(f)
        ttk.Label(f, text="Wi-Fi input (WebSocket, off by default)", font=("Sans", 11, "bold")).pack(anchor="w", pady=(12, 2))
        ttk.Label(f, wraplength=820, text="Auth uses the victorpc://pair v1 QR flow and a per-device Bearer token (never in the QR). "
                  "The Debian firewall stays closed until you turn this on, then opens only the input port. "
                  "Turn it off to close the port. Localhost admin only; unauthenticated and replayed messages are rejected.").pack(anchor="w")
        row2 = ttk.Frame(f); row2.pack(fill="x", pady=2)
        self.in_bind, self.in_port, self.in_host = tk.StringVar(value="0.0.0.0"), tk.StringVar(value="8473"), tk.StringVar()
        ttk.Label(row2, text="Listen").pack(side="left"); ttk.Entry(row2, textvariable=self.in_bind, width=16).pack(side="left", padx=4)
        ttk.Label(row2, text="Port").pack(side="left"); ttk.Entry(row2, textvariable=self.in_port, width=6).pack(side="left", padx=4)
        ttk.Button(row2, text="Turn on", style="Accent.TButton", command=self.in_on).pack(side="left", padx=2)
        ttk.Button(row2, text="Turn off", style="Danger.TButton", command=self.in_off).pack(side="left", padx=2)
        row3 = ttk.Frame(f); row3.pack(fill="x", pady=2)
        ttk.Label(row3, text="Phone should use").pack(side="left")
        ttk.Entry(row3, textvariable=self.in_host, width=24).pack(side="left", padx=4)
        ttk.Button(row3, text="Pair phone (Wi-Fi keyboard)", command=self.in_pair).pack(side="left", padx=2)
        ttk.Button(row3, text="Close pairing", command=self.in_pair_stop).pack(side="left", padx=2)
        ttk.Button(row3, text="Refresh", command=self.in_refresh).pack(side="left", padx=2)
        self.in_out = self.mkout(f)
        ttk.Label(f, wraplength=820, text="USB: Victorious Keyboard's USB HID mode (root, ConfigFS on the phone) works with no PC software. "
                  "That has not been tried on a real VictorLinux boot [Likely]. See docs/phone-as-keyboard.md.").pack(anchor="w", pady=(8, 0))

    def bt_start(self):
        self.bg(lambda: ctl("bluetooth", "start"), lambda r: self.out(self.bt_out, json.dumps(r, indent=2) if not isinstance(r, str) else r))

    def bt_confirm(self):
        self.bg(lambda: ctl("bluetooth", "confirm"), lambda r: self.out(self.bt_out, json.dumps(r, indent=2) if not isinstance(r, str) else r))

    def bt_cancel(self):
        self.bg(lambda: ctl("bluetooth", "cancel"), lambda r: self.out(self.bt_out, json.dumps(r, indent=2) if not isinstance(r, str) else r))

    def bt_refresh(self):
        def fn():
            st = ctl("bluetooth", "status")
            ls = ctl("bluetooth", "list")
            return {"status": st, "devices": ls}
        self.bg(fn, lambda r: self.out(self.bt_out, json.dumps(r, indent=2)))

    def bt_unpair(self):
        mac = self.bt_mac.get().strip()
        if not mac:
            messagebox.showerror("VictorLinux", "Enter the Bluetooth address to unpair.")
            return
        self.bg(lambda: ctl("bluetooth", "unpair", mac), lambda r: self.out(self.bt_out, json.dumps(r, indent=2) if not isinstance(r, str) else r))

    def in_on(self):
        self.bg(lambda: ctl("input", "enable", "--bind", self.in_bind.get().strip(), "--port", self.in_port.get().strip()),
                lambda r: self.out(self.in_out, json.dumps(r, indent=2) if not isinstance(r, str) else r))

    def in_off(self):
        self.bg(lambda: ctl("input", "disable"), lambda r: self.out(self.in_out, json.dumps(r, indent=2) if not isinstance(r, str) else r))

    def in_pair(self):
        host = self.in_host.get().strip()
        if not host:
            messagebox.showerror("VictorLinux", "Enter the address the phone should use.")
            return
        def fn():
            return ctl("input", "pair-start", "--host", host)
        self.bg(fn, lambda r: self.out(self.in_out, json.dumps(r, indent=2) if not isinstance(r, str) else r))

    def in_pair_stop(self):
        self.bg(lambda: ctl("input", "pair-cancel"), lambda r: self.out(self.in_out, json.dumps(r, indent=2) if not isinstance(r, str) else r))

    def in_refresh(self):
        self.bg(lambda: ctl("input", "status"), lambda r: self.out(self.in_out, json.dumps(r, indent=2) if not isinstance(r, str) else r))

    # ---- Kali
    def tab_kali(self):
        f = ttk.Frame(self.nb, padding=8); self.nb.add(f, text="Kali (optional)")
        ttk.Label(f, wraplength=800, text="Official Kali container (rootless Podman, pinned by digest, separate filesystem; Kali repositories are never added to this "
                  "Debian host). It shares the host kernel and network drivers: it is not a separate OS, kernel or Wi-Fi stack. Nothing downloads unless you choose it.").pack(anchor="w")
        b = ttk.Frame(f); b.pack(fill="x", pady=4)
        for t, fn in (("Status", self.kali_status), ("Load offline pack...", self.kali_load), ("Download image (network)", self.kali_dl),
                      ("Start", lambda: self.bg(lambda: ctl("kali", "start"), lambda r: self.out(self.kali_out, json.dumps(r, indent=2)))),
                      ("Terminal", self.kali_term), ("Stop", lambda: self.bg(lambda: ctl("kali", "stop"), lambda r: self.kali_status()))):
            ttk.Button(b, text=t, command=fn).pack(side="left", padx=2)
        self.kali_out = self.mkout(f)

    def kali_status(self):
        self.bg(lambda: ctl("kali", "status"), lambda r: self.out(self.kali_out, json.dumps(r, indent=2)))

    def kali_load(self):
        p = filedialog.askopenfilename(title="Kali pack (.tar)", initialdir="/media", filetypes=[("Pack", "*.tar *.tar.gz")])
        if p: self.bg(lambda: ctl("kali", "load-pack", p, timeout=1800), lambda r: self.kali_status())

    def kali_dl(self):
        if messagebox.askyesno("Download", "This downloads the Kali image from the internet. Continue?"):
            self.bg(lambda: ctl("kali", "download", "--yes", timeout=3600), lambda r: self.kali_status(), "downloading...")

    def kali_term(self):
        subprocess.Popen(["xfce4-terminal", "-e", "podman exec -it victor-kali /bin/bash"])

    # ---- Fleet (phones). Every action is `victor-ctl fleet ...` -> victor-fleet; the GUI holds no state or credentials.
    def tab_fleet(self):
        f = ttk.Frame(self.nb, padding=8); self.nb.add(f, text="Fleet")
        ttk.Label(f, wraplength=820, text="Coordinator for up to 4 DroidCommand phones. Off until you start it; local-only until you enable fleet networking "
                  "(victor-ctl fleet config --enable-network ADDR). Phones keep their own policy and approvals; revoke removes a phone immediately.").pack(anchor="w")
        b = ttk.Frame(f); b.pack(fill="x", pady=4)
        for t, fn in (("Refresh", self.fleet_refresh), ("Start", lambda: self.fleet_do("start")), ("Stop", lambda: self.fleet_do("stop")),
                      ("Pair phone...", self.fleet_pair), ("Pause", lambda: self.fleet_dev("pause")), ("Resume", lambda: self.fleet_dev("resume")),
                      ("Disable", lambda: self.fleet_dev("disable")), ("Enable", lambda: self.fleet_dev("enable")), ("Revoke", self.fleet_revoke),
                      ("Phone dashboard (3 screens)", self.fleet_dashboard)):
            ttk.Button(b, text=t, command=fn).pack(side="left", padx=2)
        self.fl_devs = tk.Listbox(f, height=5, exportselection=False); self.fl_devs.pack(fill="x", pady=2); self._themed.append(self.fl_devs)
        b2 = ttk.Frame(f); b2.pack(fill="x", pady=4)
        for t, fn in (("Submit plan file...", self.fleet_submit), ("Batch-hash folder...", self.fleet_batch), ("Review", lambda: self.fleet_plan("review")),
                      ("Approve", lambda: self.fleet_plan("approve")), ("Cancel", lambda: self.fleet_plan("cancel")), ("Report", lambda: self.fleet_plan("report"))):
            ttk.Button(b2, text=t, command=fn).pack(side="left", padx=2)
        self.fl_plans = tk.Listbox(f, height=4, exportselection=False); self.fl_plans.pack(fill="x", pady=2); self._themed.append(self.fl_plans)
        self.fl_out = self.mkout(f); self._fl_dev_ids = []; self._fl_plan_ids = []

    def fleet_refresh(self):
        def get():
            st = ctl("fleet", "status")
            plans = ctl("fleet", "plans") if st.get("running") else []
            return st, plans
        def done(r):
            st, plans = r
            self.fl_devs.delete(0, "end"); self._fl_dev_ids = []
            for d in st.get("devices", []):
                ds = d.get("device_state", {})
                line = (f"{d['name']}  [{d['state']}{' paused' if d['paused'] else ''}{'' if d['enabled'] else ' disabled'}]  "
                        f"{'connected' if d['connected'] else 'offline'}  bat={ds.get('battery_percent','?')}% thermal={ds.get('thermal','?')}  "
                        f"root={'yes' if d.get('capabilities', {}).get('root', {}).get('granted') else 'no'}  jobs={len(d['active_jobs'])}")
                self.fl_devs.insert("end", line); self._fl_dev_ids.append(d["id"])
            self.fl_plans.delete(0, "end"); self._fl_plan_ids = []
            for p_ in plans:
                self.fl_plans.insert("end", f"{p_['id']}  {p_['state']}  {p_['title']}"); self._fl_plan_ids.append(p_["id"])
            note = st.get("durability_warning") or ("persistent: " + st["persistence"]["reason"] if st.get("running") else "")
            self.out(self.fl_out, json.dumps({k: st.get(k) for k in ("running", "bind", "network_enabled", "fingerprint_sha256", "job_counts")}, indent=2) +
                     ("\n" + note if note else "") + ("" if st.get("running") else "\nCoordinator is stopped (press Start)."))
        self.bg(get, done)

    def fleet_dashboard(self):
        # Runs as the logged-in desktop user (this process); the dashboard refuses root and a missing display itself.
        try:
            subprocess.Popen(["/usr/local/bin/victor-phone-dash"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError as e:
            messagebox.showerror("Phone dashboard", f"Could not start victor-phone-dash: {e}")

    def fleet_do(self, cmd):
        self.bg(lambda: ctl("fleet", cmd), lambda r: (self.out(self.fl_out, r if isinstance(r, str) else json.dumps(r, indent=2)), self.after(600, self.fleet_refresh)))

    def _fl_sel(self, lb, ids):
        i = lb.curselection()
        if not i: messagebox.showinfo("Fleet", "Select an item first."); return None
        return ids[i[0]]

    def fleet_dev(self, cmd):
        d = self._fl_sel(self.fl_devs, self._fl_dev_ids)
        if d: self.bg(lambda: ctl("fleet", cmd, d), lambda r: self.fleet_refresh())

    def fleet_revoke(self):
        d = self._fl_sel(self.fl_devs, self._fl_dev_ids)
        if d and messagebox.askyesno("Revoke", "Revoke this phone? Its credential stops working immediately and its running jobs are parked for review."):
            self.bg(lambda: ctl("fleet", "revoke", d), lambda r: self.fleet_refresh())

    def fleet_pair(self):
        def done(r):
            self.out(self.fl_out, "PAIRING (single use, expires in %ss)\nCoordinator: %s\nVerify this fingerprint matches what the phone shows BEFORE approving:\n  %s\n\nPairing secret (enter on the phone):\n  %s\n" %
                     (r["expires_in_s"], r["coordinator_url"], r["coordinator_fingerprint_sha256"], r["pairing_secret"]))
        self.bg(lambda: ctl("fleet", "pair"), done)

    def fleet_submit(self):
        p = filedialog.askopenfilename(title="Fleet plan (JSON)", filetypes=[("JSON", "*.json")])
        if p: self.bg(lambda: ctl("fleet", "submit", p), lambda r: (self.out(self.fl_out, json.dumps(r, indent=2)), self.fleet_refresh()))

    def fleet_batch(self):
        d = filedialog.askdirectory(title="Folder of files to hash across phones")
        if d: self.bg(lambda: ctl("fleet", "workflow", "batch-hash", "--root", d), lambda r: (self.out(self.fl_out, json.dumps(r, indent=2)), self.fleet_refresh()))

    def fleet_plan(self, cmd):
        p = self._fl_sel(self.fl_plans, self._fl_plan_ids)
        if p: self.bg(lambda: ctl("fleet", cmd, p), lambda r: (self.out(self.fl_out, r if isinstance(r, str) else json.dumps(r, indent=2)), self.fleet_refresh() if cmd != "report" and cmd != "review" else None))

    # ---- Storage
    def tab_storage(self):
        f = ttk.Frame(self.nb, padding=8); self.nb.add(f, text="Storage")
        ttk.Label(f, wraplength=800, text="Persistent app data (models, chats, settings, images, Kali work, documents, bounded logs) lives on a VICTORDATA partition. "
                  "The OS itself is NOT persistent. Pick one partition explicitly if several are attached.").pack(anchor="w")
        self.cand = tk.Listbox(f, height=6); self.cand.pack(fill="x", pady=4); self._themed.append(self.cand)
        b = ttk.Frame(f); b.pack(fill="x")
        for t, fn in (("Rescan", self.scan), ("Use selected partition", self.use_sel), ("Temporary session (RAM only)", self.session)):
            ttk.Button(b, text=t, command=fn).pack(side="left", padx=2)
        b2 = ttk.Frame(f); b2.pack(fill="x", pady=4)
        for t, fn in (("Storage health", self.health), ("Back up now...", self.backup), ("Restore...", self.restore)):
            ttk.Button(b2, text=t, command=fn).pack(side="left", padx=2)
        self.stor_out = self.mkout(f); self.after(1200, self.scan)

    def scan(self):
        def done(s):
            self._cands = s["candidates"]; self.cand.delete(0, "end")
            for c in self._cands:
                self.cand.insert("end", f"UUID {c['uuid']}  {c['size']/2**30:.1f} GiB  {c['model']} {c['serial']} ({c['transport']})")
            self.out(self.stor_out, f"{s['state']}: {s['message']}")
        self.bg(lambda: ctl("storage", "status"), done)

    def health(self):
        def show(r):
            lines = [f"Overall: {r['status']}"]
            lines += [f"{s['label']}: {s['pct_free']}% free ({s['free'] / 2**30:.1f} GiB) {s['fix']}" for s in r["space"]]
            for d in r["smart"]:
                lines += [f"{d['device']} {d.get('model', '')}: SMART {d['status']}"] + [f"  - {x['text']} {x['fix']}" for x in d["findings"]]
            self.out(self.stor_out, "\n".join(lines))
        self.bg(lambda: ctl("storage", "health", timeout=180), show, "checking drives...")

    def _ask_pass(self, title, confirm=False):
        from tkinter import simpledialog
        p = simpledialog.askstring(title, "Backup passphrase (10+ characters):", show="*", parent=self)
        if not p:
            return None
        if confirm and simpledialog.askstring(title, "Repeat the passphrase:", show="*", parent=self) != p:
            messagebox.showerror(title, "The passphrases do not match."); return None
        return p

    def backup(self):
        p = self._ask_pass("Encrypted backup", confirm=True)
        if not p: return
        sec = messagebox.askyesno("Encrypted backup", "Also include the API key and TLS keys? (No is safer.)", default="no")
        args = ["backup", "create"] + (["--include-secrets"] if sec else [])
        self.bg(lambda: ctl(*args, stdin=p + "\n", timeout=600), lambda r: self.out(self.stor_out, f"Encrypted backup saved: {r['path']} ({r['files']} files)"), "encrypting...")

    def restore(self):
        f = filedialog.askopenfilename(title="Choose a VictorLinux backup", filetypes=[("VictorLinux backup", "*.vlbak")])
        if not f: return
        p = self._ask_pass("Restore backup")
        if not p: return
        def checked(r):
            self.out(self.stor_out, f"Verified backup from {r['created']}:\n" + "\n".join(x["path"] for x in r["files"]))
            if messagebox.askyesno("Restore backup", f"Verified {len(r['files'])} files. Replace your current settings and chats? Current files are copied to a pre-restore folder first.", default="no"):
                self.bg(lambda: ctl("backup", "restore", f, "--yes", stdin=p + "\n"), lambda x: self.out(self.stor_out, f"Restored {x['restored']} files. Previous copies: {x['previous_dir']}"), "restoring...")
        self.bg(lambda: ctl("backup", "inspect", f, stdin=p + "\n"), checked, "verifying...")

    def use_sel(self):
        i = self.cand.curselection()
        if not i: return messagebox.showwarning("Storage", "Select a partition first.")
        self.bg(lambda: ctl("storage", "select", self._cands[i[0]]["uuid"]), lambda r: self.scan())

    def session(self):
        if messagebox.askyesno("Temporary session", "Nothing will be saved. Continue?"):
            self.bg(lambda: ctl("storage", "session"), lambda r: self.scan())

    # ---- Diagnostics
    def tab_docs(self):
        """Ask your documents: only folders the owner adds; local index; answers from the local model only."""
        f = ttk.Frame(self.nb, padding=8); self.nb.add(f, text="Documents")
        q = ttk.Frame(f); q.pack(fill="x")
        ttk.Label(q, text="Question:").pack(side="left")
        self.doc_q = ttk.Entry(q); self.doc_q.pack(side="left", fill="x", expand=True, padx=4)
        ttk.Button(q, text="Ask", style="Accent.TButton", command=lambda: self.doc_run("ask")).pack(side="left", padx=2)
        ttk.Button(q, text="Search only", command=lambda: self.doc_run("search")).pack(side="left", padx=2)
        b = ttk.Frame(f); b.pack(fill="x", pady=4)
        ttk.Button(b, text="Add folder...", command=self.doc_add).pack(side="left", padx=2)
        ttk.Button(b, text="Index now", command=lambda: self.bg(lambda: ctl("docs", "index", timeout=3600), lambda r: self.out(self.doc_out, json.dumps(r, indent=2)), "indexing...")).pack(side="left", padx=2)
        ttk.Button(b, text="Folders", command=lambda: self.bg(lambda: ctl("docs", "list"), lambda r: self.out(self.doc_out, json.dumps(r, indent=2)))).pack(side="left", padx=2)
        self.doc_out = self.mkout(f)

    def doc_add(self):
        d = filedialog.askdirectory(title="Folder to index (only folders you choose are read)")
        if d:
            self.bg(lambda: ctl("docs", "add", d), lambda r: self.out(self.doc_out, f"Added {r['added']}. Press Index now."))

    def doc_run(self, cmd):
        q = self.doc_q.get().strip()
        if not q:
            return
        def show(r):
            parts = [r.get("answer") or r.get("message") or ""]
            parts += [f"[{i + 1}] {h['path']}\n{h['text']}" for i, h in enumerate(r.get("hits", []))]
            self.out(self.doc_out, "\n\n".join(p for p in parts if p) or "Nothing matches. Add a folder and index it.")
        self.bg(lambda: ctl("docs", cmd, q, timeout=900), show, "thinking on this PC...")

    def tab_diag(self):
        f = ttk.Frame(self.nb, padding=8); self.nb.add(f, text="Diagnostics")
        b = ttk.Frame(f); b.pack(fill="x")
        for t, fn in (("Check this PC", self.pc_check), ("Collect diagnostics", self.diag), ("Copy to clipboard", self.copy), ("Run benchmark", self.benchmark), ("Versions", self.versions), ("Suggest models for this PC", self.recommend), ("Save log snapshot", lambda: self.bg(lambda: ctl("diag", "save-log"), lambda r: self.out(self.diag_out, r)))):
            ttk.Button(b, text=t, command=fn).pack(side="left", padx=2)
        self.diag_out = self.mkout(f)

    def pc_check(self):
        self.bg(lambda: ctl("diag", "check", timeout=180),
                lambda r: self.out(self.diag_out, r["text"] + (f"\n\nSaved: {r['saved']['report']}" if (r.get("saved") or {}).get("report") else "")),
                "checking this PC...")

    def diag(self):
        self.bg(lambda: ctl("diag", "show", timeout=180), lambda r: self.out(self.diag_out, json.dumps(r, indent=2)), "collecting...")

    def copy(self):
        self.clipboard_clear(); self.clipboard_append(self.diag_out.get("1.0", "end")); self.status_var.set("copied (contains no keys or passwords)")

    def benchmark(self):
        self.bg(lambda: ctl("bench", "run", timeout=3700), lambda r: self.out(self.diag_out, json.dumps(r, indent=2)), "benchmarking (stop the service first)...")

    def versions(self):
        self.bg(lambda: ctl("versions", "show", timeout=180), lambda r: self.out(self.diag_out, json.dumps(r, indent=2)))


if __name__ == "__main__":
    App().mainloop()
