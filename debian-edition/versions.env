# VictorLinux (Debian edition) pinned inputs. Everything that is fetched at BUILD time is pinned here.
# Edit deliberately; scripts/gen-manifest.sh records what was actually used.
DEBIAN_SUITE=trixie                      # Debian 13 "stable" (verified 13.7 on 2026-11-14)
DEBIAN_MIRROR=https://deb.debian.org/debian
DEBIAN_SECURITY_MIRROR=https://deb.debian.org/debian-security
LIVE_BUILD_VERSION=20250505+deb13u1      # Debian trixie live-build
LLAMACPP_REPO=https://github.com/ggml-org/llama.cpp
LLAMACPP_TAG=b12375
LLAMACPP_COMMIT=9d25e0014c4b4b316873c01f4938c0e3c687287d
KALI_IMAGE=docker.io/kalilinux/kali-rolling
KALI_DIGEST=sha256:6ec743d9fc5cd397451eeddeff3869bcfab5de9bd5dec5b1f34cbfbd80313073
VENTOY_VERSION=1.1.18
IMAGE_NAME=VictorLinux
# Victorious Mesh: tailscale/tailscaled from Tailscale's own apt repository (not in Debian). BUILD time only; the repo
# is removed from the image afterwards. The keyring file must match this SHA-256 (signing key fingerprint
# 2596A99EAAB33821893C0A79458CA832957F5868) or tailscale is left out without failing the build.
TAILSCALE_REPO=https://pkgs.tailscale.com/stable/debian
TAILSCALE_KEYRING_SHA256=3e03dacf222698c60b8e2f990b809ca1b3e104de127767864284e6c228f1fb39
# RustDeskV (built in, default ON; build with VICTOR_RUSTDESKV=0 to leave it out). INTERIM SOURCE: Victorious93/rustdeskV publishes no
# release artifacts yet, so this is the upstream RustDesk release the fork is based on. The .deb must match this SHA-256 or the build
# stops. When rustdeskV publishes a Linux .deb, change the three values below. The Arch edition pins its own package in .ci/options.ini.
RUSTDESKV_REPO=https://github.com/rustdesk/rustdesk
RUSTDESKV_VERSION=1.5.3
RUSTDESKV_DEB_SHA256=81096d2f65fd43352540c351bca15bb0712a2a6f9efa4c95e9fff25cb97b3b81
