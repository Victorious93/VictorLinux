#
# /etc/pacman.conf (VictorLinux build) - packages are pinned to an Arch Linux Archive snapshot
# so the same inputs give the same package set. See .ci/options.ini [build] arch_snapshot.
#
[options]
HoldPkg     = pacman glibc
Architecture = auto
ParallelDownloads = 5
# the Arch Linux Archive can be slow or throttled from CI runners; do not abort on the low-speed timeout
DisableDownloadTimeout
SigLevel    = Required DatabaseOptional
LocalFileSigLevel = Optional

[core]
Server = https://archive.archlinux.org/repos/{{ build.arch_snapshot }}/$repo/os/$arch

[extra]
Server = https://archive.archlinux.org/repos/{{ build.arch_snapshot }}/$repo/os/$arch
